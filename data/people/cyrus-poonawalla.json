  "role": "疫苗制造企业家 · 印度血清研究所创始人",
  "summary": "普纳瓦拉出身浦那育马家庭，学习商科后于1966年创办印度血清研究所，扩大抗毒血清和疫苗的本土生产。企业逐步进入国际公共采购体系，成为全球重要疫苗供应商，并参与新冠疫苗规模化生产。他的贡献主要在企业建设与生产能力，疫苗研究、临床验证及日常经营则依赖科研团队、合作机构和后继管理层。",
  "highlights": [
    {
      "id": "h1",
      "title": "规模化疫苗制造",
      "text": "建立印度血清研究所，发展低成本生物制品及国际供应能力。",
      "sourceIds": [
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "全球公共卫生供应",
      "text": "企业通过世卫组织预认证与联合国采购等渠道供应疫苗，成果来自团队与合作伙伴。",
      "sourceIds": [
        "s2",
        "s4"
      ]
    }
  ],
  "facts": [
    {
      "id": "f1",
      "label": "出生",
      "value": "1941年5月11日生于印度，成长于浦那家庭。"
    },
    {
      "id": "f2",
      "label": "教育",
      "value": "就读浦那Brihan Maharashtra College of Commerce；牛津大学2019年所授为荣誉博士。"
    }
  ],
