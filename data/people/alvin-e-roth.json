  "role": "经济学家 · 市场设计研究者",
  "summary": "罗斯将博弈论、实验和实际制度设计结合，研究没有价格或受到规则约束的匹配市场。他与合作者改进医生岗位分配、学校录取和肾脏交换制度，强调参与者激励与操作细节。2012年与沙普利分享经济学奖，后在斯坦福继续研究；2026年出版新书讨论市场交易背后的道德冲突。",
  "highlights": [
    {
      "id": "h1",
      "title": "匹配制度",
      "text": "与合作者把稳定匹配理论用于医生岗位和学校录取规则。",
      "sourceIds": [
        "s2",
        "s3"
      ]
    },
    {
      "id": "h2",
      "title": "肾脏交换",
      "text": "参与设计肾脏交换机制，使不相容供受者能够通过交换获得匹配。",
      "sourceIds": [
        "s3"
      ]
    }
  ],
