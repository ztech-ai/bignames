  "role": "哲学家 · 文化批评者",
  "summary": "齐泽克在卢布尔雅那研究哲学，后在巴黎学习精神分析，以黑格尔、马克思及拉康为基础讨论意识形态。他把电影、笑话和大众文化引入理论写作，通过译著、讲座及媒体形成广泛影响。其政治主张和挑衅修辞常引发争论；2014年文章未注明借用来源遭批评，他称使用友人摘要并表示遗憾。曾任伯克贝克人文研究所国际主任至2025年。",
  "highlights": [
    {
      "id": "h1",
      "title": "意识形态批评",
      "text": "结合拉康精神分析和德国观念论，通过文化案例解释意识形态如何运作。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "跨语言公共思想",
      "text": "通过著作、电影讨论和讲座把理论带入公共争论，其政治判断持续受到批评与回应。",
      "sourceIds": [
        "s3",
        "s4"
      ]
    }
  ],
