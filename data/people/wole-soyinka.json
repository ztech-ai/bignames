    },
    {
      "id": "t2",
      "title": "长篇小说再度问世",
      "text": "出版《地球上最幸福的人们的国度纪事》，以虚构尼日利亚讽刺个人与政治腐败。",
      "sourceIds": [
        "s4"
      ],
      "date": "2021"
    },
    {
      "id": "t3",
      "title": "获得诺贝尔文学奖",
      "text": "瑞典学院肯定其具有广阔文化视野的戏剧创作，使非洲文学获得新的国际关注。",
      "sourceIds": [
        "s1"
      ],
      "date": "1986"
    },
    {
      "id": "t4",
      "title": "发表重要剧作",
      "text": "《死亡与国王的侍从》出版，将约鲁巴仪式与殖民统治背景下的冲突带入戏剧。",
      "sourceIds": [
        "s1",
        "s2"
      ],
      "date": "1975"
    },
    {
      "id": "t5",
      "title": "内战期间被监禁",
      "text": "因试图阻止尼日利亚内战而被捕，经历长期单独关押，直至1969年获释。",
      "sourceIds": [
        "s1",
        "s3"
      ],
      "date": "1967"
    },
    {
      "id": "t6",
      "title": "回国开展戏剧工作",
      "text": "返回尼日利亚并创立剧团；《森林之舞》与独立时期的文化活动相联系。",
      "sourceIds": [
