  "role": "计算机科学家 · 机器人研究者",
  "summary": "鲁斯出生于罗马尼亚，移居美国后学习计算机与数学，在康奈尔完成博士训练。她先在达特茅斯建立机器人研究工作，后加入麻省理工，并于2012年出任CSAIL主任。其研究涉及分布式、自重构与软体机器人，以及自主系统和人机协作，强调机体、算法及环境的结合。她也通过著作讨论机器人与人工智能的社会应用，相关成果来自跨学科团队协作。",
  "highlights": [
    {
      "id": "h1",
      "title": "可变形与软体机器人",
      "text": "研究自重构系统、软体机体及控制方法，使机器人适应不同环境。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "分布式智能与协作",
      "text": "结合算法、感知和物理结构，探索自主机器及人机交互。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    }
  ],
