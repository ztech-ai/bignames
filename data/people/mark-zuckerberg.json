  "role": "Facebook 联合创始人 · 社交网络",
  "summary": "扎克伯格在哈佛求学期间与伙伴创建 Facebook，使校园社交网站发展为全球性平台。他推动 Instagram、WhatsApp 等业务纳入同一企业体系，并在 2021 年宣布公司更名 Meta，投入虚拟与增强现实。用户隐私、平台权力及内容治理也持续构成其事业的重要争议。",
  "highlights": [
    {
      "title": "建立全球社交平台",
      "text": "2004 年与伙伴创办 Facebook，推动网络社交走向大众。",
      "sourceIds": [
        "company"
      ],
      "id": "highlight-01"
    },
    {
      "title": "拓展移动产品体系",
      "text": "先后收购 Instagram 与 WhatsApp，将照片分享和即时通讯纳入业务。",
      "sourceIds": [
        "instagram",
        "whatsapp"
      ],
      "id": "highlight-02"
    },
    {
      "title": "发起科学与公益投入",
      "text": "2015 年与普莉希拉·陈成立 Chan Zuckerberg Initiative，支持科学研究及社会议题。",
      "sourceIds": [
        "czi"
      ],
      "id": "highlight-03"
    }
  ],
