  "role": "万维网发明者 · 开放标准倡导者",
  "summary": "蒂姆·伯纳斯-李在CERN提出并实现万维网，把超文本与互联网连接起来。他建立W3C推动互操作标准，并持续倡导开放访问和用户数据自主权。万维网是建立在互联网之上的信息系统，并非互联网本身的发明。",
  "highlights": [
    {
      "id": "highlight-1",
      "title": "创建万维网",
      "text": "提出Web架构，编写首个浏览器和服务器，推动HTTP、HTML与URI发展。",
      "sourceIds": [
        "cern",
        "bio"
      ]
    },
    {
      "id": "highlight-2",
      "title": "开放标准与数据自主权",
      "text": "通过W3C和Solid等项目，推动网络互操作及个人数据控制。",
      "sourceIds": [
        "bio"
      ]
    }
  ],
