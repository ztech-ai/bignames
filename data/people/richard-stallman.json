  "role": "自由软件运动发起者 · GNU开发者",
  "summary": "理查德·斯托曼发起GNU计划与自由软件运动，主张用户拥有运行、研究、修改和分享软件的自由。他开发GNU Emacs、编译器等工具，创办自由软件基金会，并以copyleft许可保护再分发权利。其技术与伦理倡议影响软件社群；公开言论也引发争议，导致2019年辞职及2021年重返基金会董事会后的反对。",
  "highlights": [
    {
      "id": "highlight-1",
      "title": "GNU与自由软件",
      "text": "建立GNU计划，开发编辑器、编译器和调试器等自由软件基础工具。",
      "sourceIds": [
        "bio",
        "hall"
      ]
    },
    {
      "id": "highlight-2",
      "title": "Copyleft许可",
      "text": "推动以版权许可保留用户复制、修改与再分发自由的做法。",
      "sourceIds": [
        "bio",
        "gpl"
      ]
    }
  ],
  "facts": [
    {
      "id": "fact-1",
      "label": "出生地",
      "value": "美国纽约市"
    },
    {
      "id": "fact-2",
      "label": "教育",
      "value": "哈佛大学物理学学士（1974）；曾在MIT攻读研究生"
    }
  ],
  "timeline": [
    {
      "id": "event-1",
      "date": "2021-03",
      "title": "重返FSF董事会引发反对",
      "text": "宣布重返董事会；欧洲自由软件基金会等组织公开反对这一决定。",
      "sourceIds": [
        "return"
      ]
    },
    {
      "id": "event-2",
      "date": "2019-09-16",
      "title": "辞去FSF领导职务",
      "text": "在言论争议中辞去自由软件基金会主席及董事职位。",
      "sourceIds": [
        "resign",
        "return"
      ]
    },
    {
      "id": "event-3",
      "date": "1990",
      "title": "获麦克阿瑟奖与霍珀奖",
      "text": "软件开发工作获得麦克阿瑟研究员资助及ACM格蕾丝·霍珀奖。",
      "sourceIds": [
        "bio"
      ]
    },
    {
      "id": "event-4",
      "date": "1989-02",
      "title": "GNU GPL第一版发布",
      "text": "通用公共许可证首版发布，把自由软件的再分发条件写成通用许可。",
      "sourceIds": [
        "gpl"
      ]
    },
    {
      "id": "event-5",
      "date": "1985-10",
      "title": "创办自由软件基金会",
      "text": "设立非营利组织支持GNU与自由软件运动。",
      "sourceIds": [
        "bio"
      ]
    },
    {
      "id": "event-6",
      "date": "1984-01",
      "title": "开始全职开发GNU",
      "text": "离开MIT雇员岗位，着手实现此前宣布的自由操作系统计划。",
      "sourceIds": [
        "bio"
      ]
    },
    {
      "id": "event-7",
      "date": "1983-09",
      "title": "宣布GNU计划",
      "text": "公开提出开发由自由软件构成的类Unix操作系统。",
      "sourceIds": [
        "bio",
        "hall"
      ]
    },
    {
      "id": "event-8",
      "date": "1976",
      "title": "参与开发Emacs",
      "text": "在MIT人工智能实验室开发可扩展编辑器，形成其重要软件贡献之一。",
      "sourceIds": [
        "bio"
      ]
    },
    {
      "id": "event-9",
      "date": "1974",
      "title": "取得物理学学士",
