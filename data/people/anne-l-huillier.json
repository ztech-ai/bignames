  "role": "物理学家 · 超快光学研究者",
  "summary": "吕利耶出生于巴黎，在法国完成博士训练后研究强激光与原子的相互作用。她参与发现高次谐波产生现象，并研究其机制，为合成阿秒光脉冲提供基础。移居瑞典后长期在隆德大学开展实验与理论工作，探索电子在极短时间内的动态。2023年与阿戈斯蒂尼、克劳斯共同获得诺贝尔物理学奖，获奖工作建立在多支研究团队长期积累之上。",
  "highlights": [
    {
      "id": "h1",
      "title": "高次谐波研究",
      "text": "参与观察并解释强激光作用于气体时的高次谐波，拓展极紫外光源。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "阿秒测量基础",
      "text": "发展产生超短光脉冲的方法，为研究物质中电子动态提供工具。",
      "sourceIds": [
        "s2",
        "s3"
      ]
    }
  ],
