  "role": "NVIDIA 联合创始人 · 加速计算",
  "summary": "黄仁勋是 NVIDIA 联合创始人，早年从台湾移居美国，接受电气工程训练。其带领的团队从个人电脑图形芯片起步，逐步将 GPU 扩展为科学计算和人工智能的重要工具。CUDA 软件生态、深度学习计算与数据中心平台，是理解其产业影响的几条主线。",
  "highlights": [
    {
      "title": "联合创办 NVIDIA",
      "text": "1993 年与 Chris Malachowsky、Curtis Priem 一同创立 NVIDIA。",
      "sourceIds": [
        "history"
      ],
      "id": "highlight-01"
    },
    {
      "title": "推动 GPU 通用计算",
      "text": "公司于 2006 年公布 CUDA 架构，使 GPU 并行计算能力向科研与开发者开放。",
      "sourceIds": [
        "history"
      ],
      "id": "highlight-02"
    },
    {
      "title": "人工智能基础设施",
      "text": "从支持 AlexNet 训练到发布 Blackwell 平台，推动 GPU 在深度学习中的应用。",
      "sourceIds": [
        "history",
        "blackwell"
      ],
      "id": "highlight-03"
    }
  ],
