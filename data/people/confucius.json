  "role": "思想家与教育者 · 儒家传统的重要人物",
  "summary": "孔子是春秋时期的思想家与教育者，其关于仁、礼、修身和政治秩序的讨论深刻影响东亚思想。他的言行由后学整理、传承，成为《论语》等文本的重要内容。生卒年通常按传统记为公元前551年至前479年；许多生平细节来自较晚文献，应区分历史记载、后世诠释与传说。",
  "highlights": [
    {
      "title": "伦理与政治思想",
      "text": "围绕仁、礼与德行展开思考，讨论个人修养及人与社会的关系。",
      "sourceIds": [
        "s1"
      ],
      "id": "highlight-01"
    },
    {
      "title": "教育与后学传承",
      "text": "其教学及弟子传统经由《论语》等文献延续，对东亚教育与思想产生长期影响。",
      "sourceIds": [
        "s2",
        "s3"
      ],
      "id": "highlight-02"
    }
  ],
  "facts": [
    {
      "label": "出生地",
      "value": "传统记为鲁国陬邑（今山东一带）",
      "id": "fact-01"
    },
    {
      "label": "姓名",
      "value": "名丘，字仲尼",
      "id": "fact-02"
    },
    {
      "label": "核心文献",
      "value": "《论语》由后学编纂，非孔子本人定稿著作",
      "id": "fact-03"
    }
  ],
  "timeline": [
    {
      "date": "-0479",
      "title": "在鲁国逝世",
      "text": "传统生平以此年为卒年；弟子与后学随后逐渐记录、整理其言行。",
      "sourceIds": [
        "s2"
      ],
      "dateLabel": "公元前479年（传统纪年）",
      "id": "event-01"
    },
    {
      "date": "-0484",
      "title": "返回鲁国，晚年授徒",
      "text": "传统记载称其结束长期游历返回鲁国，晚年专注教学与古代文献传承。",
      "sourceIds": [
        "s2",
        "s3"
      ],
      "dateLabel": "约公元前484年",
      "id": "event-02"
    },
    {
      "date": "-0497",
      "title": "离鲁并周游列国",
      "text": "按常见生平叙述，与弟子离开鲁国，到多国寻求施展政治理念的机会。",
      "sourceIds": [
