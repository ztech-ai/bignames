  "role": "经济学家 · 贫困与公共政策研究者",
  "summary": "埃丝特·迪弗洛把随机对照试验应用于教育、健康和贫困政策评估，并与合作者共同创办J-PAL研究网络。她结合实地实验与经济理论，研究具体干预在现实条件下的效果，而非以单一理论解释贫困。2019年与班纳吉、克雷默共享经济学奖；2026年加入苏黎世大学，同时延续与麻省理工学院及法兰西公学院的联系。",
  "highlights": [
    {
      "id": "highlight-01",
      "title": "将实验用于减贫政策",
      "text": "与合作者通过实地随机评估研究教育、健康和金融服务，因实验性减贫方法共享2019年经济学奖。",
      "sourceIds": [
        "mit",
        "nber",
        "independent"
      ]
    },
    {
      "id": "highlight-02",
      "title": "建立跨国研究网络",
      "text": "2003年与班纳吉、穆莱纳森共同创办J-PAL，连接研究者与政策实施者。",
      "sourceIds": [
        "uzh",
        "cv"
      ]
    }
  ],
