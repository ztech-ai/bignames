        "s5"
      ],
      "title": "扩展细胞工程工具",
      "text": "团队推进Cas9在人类等细胞中的编辑，发展针对DNA、RNA的更多工具与递送方法。"
    },
    {
      "id": "h2",
      "sourceIds": [
        "s2",
        "s4"
      ],
      "title": "科学技术荣誉",
      "text": "获2024年度国家技术与创新奖章，2025年受颁；2026年入选国家发明家名人堂。"
    }
  ],
