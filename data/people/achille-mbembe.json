      "id": "h1",
      "title": "死亡政治",
      "text": "研究权力如何决定生命与死亡，把殖民暴力、战争及种族问题纳入理论讨论。",
      "sourceIds": [
        "s1",
        "s6"
      ]
    },
    {
      "id": "h2",
      "title": "跨地域思想工作",
      "text": "通过后殖民研究、教学及学术组织，把非洲经验带入全球政治理论讨论。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    }
  ],
