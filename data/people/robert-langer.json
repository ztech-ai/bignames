  "role": "化学工程师、生物材料研究者、麻省理工学院教授",
  "summary": "兰格把化学工程用于药物递送、生物材料和组织工程，探索用聚合物及纳米载体控制治疗分子的释放。他在麻省理工学院培养跨学科团队，并通过专利许可和共同创业推动医疗技术转化，是Moderna共同创办人之一。",
  "highlights": [
    {
      "id": "h1",
      "sourceIds": [
        "s2",
        "s3",
        "s8"
      ],
      "title": "让材料承担治疗功能",
      "text": "早期与Judah Folkman合作研究大分子的持续释放，后来把可降解材料与药物递送结合，推动局部治疗等应用。"
    },
    {
      "id": "h2",
      "sourceIds": [
        "s4",
        "s7"
      ],
      "title": "连接实验室与产业",
      "text": "与合作者发展组织工程和递送系统，通过企业合作、专利及创业实现转化；获批产品依赖临床、监管和产业团队共同努力。"
    }
  ],
  "facts": [
