  "role": "创作歌手 · 诺贝尔文学奖得主",
  "summary": "鲍勃·迪伦把民谣、布鲁斯与摇滚带入持续变化的歌曲写作，将社会观察、个人经验和诗性意象融入流行音乐。他从纽约民谣圈起步，经历电声转向与多次风格变化，作品影响了音乐人与文学读者。2016年获得诺贝尔文学奖，晚年仍发行作品并巡演。",
  "highlights": [
    {
      "id": "highlight-1",
      "title": "扩展歌曲的文学空间",
      "text": "以叙事、意象和社会观察扩展流行歌词的表达，获得诺贝尔文学奖与普利策特别奖。",
      "sourceIds": [
        "nobel",
        "pulitzer"
      ]
    },
    {
      "id": "highlight-2",
      "title": "持续改变创作方式",
      "text": "从民谣转向电声摇滚，并继续探索不同唱法、录音与巡演形式。",
      "sourceIds": [
        "albums",
        "tour"
      ]
    }
  ],
