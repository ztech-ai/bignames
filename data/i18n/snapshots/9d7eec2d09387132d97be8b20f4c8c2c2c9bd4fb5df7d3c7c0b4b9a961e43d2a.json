    "role": "AI研究者、零一万物创始人兼CEO、创新工场董事长",
    "summary": "李开复从语音识别研究走向科技企业经营，曾任职苹果、SGI、微软及谷歌，参与建立微软中国研究院。2009年创办创新工场，2023年创办零一万物，连接投资、技术创业与企业AI应用。他也通过《AI·未来》等著作讨论就业与产业变化；其中未来预测属于其观点，不能视为已验证结果。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s10",
          "s11"
        ],
        "title": "语音识别研究",
        "text": "博士期间在Raj Reddy指导下与Roberto Bisiani等发展Sphinx，推进大词汇量、非特定说话人连续语音识别。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s1",
          "s3",
          "s5",
          "s6"
        ],
        "title": "技术、投资与公众讨论",
        "text": "通过创新工场、零一万物及科普著作，推动科技创业并讨论AI对工作和企业组织的影响。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "台湾台北"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "哥伦比亚大学计算机科学学士；卡内基梅隆大学计算机科学博士"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-11-03",
        "sourceIds": [
          "s1"
        ],
        "title": "《AI Native》美国精装版出版",
        "text": "新书讨论企业如何调整组织和工作流程以应用AI；电子及有声版本此前已发行。"
      },
      {
        "id": "t2",
        "date": "2025",
        "sourceIds": [
          "s2"
        ],
        "title": "零一万物转向企业应用",
        "text": "公司停止从头预训练更大模型，转向利用DeepSeek等模型提供定制企业AI方案。"
      },
      {
        "id": "t3",
        "date": "2023-03",
        "sourceIds": [
          "s3",
          "s4"
        ],
        "title": "创办零一万物",
        "text": "成立01.AI并任CEO，初期开发Yi系列大语言模型，后拓展企业智能应用。"
      },
      {
        "id": "t4",
        "date": "2018",
        "sourceIds": [
          "s5"
        ],
        "title": "出版《AI·未来》",
        "text": "以《AI Superpowers》讨论中美AI产业、就业变化与社会应对，扩大公共讨论。"
      },
      {
        "id": "t5",
        "date": "2009-09-07",
        "sourceIds": [
          "s6"
        ],
        "title": "创办创新工场",
        "text": "离开谷歌后在北京宣布成立投资与创业培育机构，支持科技创业者。"
      },
      {
        "id": "t6",
        "date": "2005-07",
        "sourceIds": [
          "s4",
          "s7",
          "s8"
        ],
        "title": "加入谷歌领导中国业务",
        "text": "从微软转任谷歌，后任大中华区总裁；竞业限制纠纷引发诉讼，双方同年12月和解。"
      },
      {
        "id": "t7",
        "date": "1998-07",
        "sourceIds": [
          "s4",
          "s9"
        ],
        "title": "加入微软研究院",
        "text": "从SGI转入微软，并于该年建立和领导微软中国研究院，后称微软亚洲研究院。"
      },
      {
        "id": "t8",
        "date": "1990-09",
        "sourceIds": [
          "s4"
        ],
        "title": "进入苹果公司",
        "text": "从卡内基梅隆转向产业，陆续领导语音、多媒体与交互媒体相关团队。"
      },
      {
        "id": "t9",
        "date": "1988-05",
        "sourceIds": [
          "s10",
          "s11"
        ],
        "title": "完成博士与Sphinx研究",
        "text": "取得卡内基梅隆计算机科学博士；该年Sphinx展示连续语音识别进展，之后留校任教。"
      },
      {
        "id": "t10",
        "date": "1983",
        "sourceIds": [
          "s12"
        ],
        "title": "取得哥伦比亚本科学位",
        "text": "完成计算机科学本科，随后赴卡内基梅隆继续研究。"
      }
    ],
