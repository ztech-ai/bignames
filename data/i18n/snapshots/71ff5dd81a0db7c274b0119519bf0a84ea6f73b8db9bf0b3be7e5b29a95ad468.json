    "role": "巴西总统 · 工会运动出身",
    "summary": "卢拉从金属工人与工会领袖成长为巴西总统，2003至2010年执政，并于2023年重返总统职位。他推动家庭补助和反饥饿政策，在经济增长时期扩大社会保障，提升巴西在全球南方合作中的地位。腐败调查使他一度入狱并失去参选资格，相关定罪后来因管辖权与法官偏见问题被撤销；2026年再度赢得选举。",
    "facts": [
      {
        "id": "fact-01",
        "label": "出生地",
        "value": "伯南布哥州加拉纽斯地区，巴西（今卡埃特斯）"
      },
      {
        "id": "fact-02",
        "label": "教育与职业训练",
        "value": "巴西工业培训服务体系（SENAI）车工训练"
      }
    ],
    "highlights": [
      {
        "id": "highlight-01",
        "title": "减贫与收入保障",
        "text": "任内扩展家庭补助等社会政策，经济增长与转移支付共同改善生活条件。",
        "sourceIds": [
          "worldbank",
          "crs"
        ]
      },
      {
        "id": "highlight-02",
        "title": "工会到总统的政治转变",
        "text": "参与创建劳工党，多次竞逐总统职位，并在法律与选举挫折后重返执政。",
        "sourceIds": [
          "bio",
          "court",
          "election"
        ]
      }
    ],
    "timeline": [
      {
        "id": "event-01",
        "date": "2026-10-25",
        "title": "再次赢得总统选举",
        "text": "在第二轮击败弗拉维奥·博索纳罗，赢得下一届任期；该任期尚未开始。",
        "sourceIds": [
          "election",
          "ap-election"
        ]
      },
      {
        "id": "event-02",
        "date": "2023-01-01",
        "title": "重返总统职位",
        "text": "在2022年击败雅伊尔·博索纳罗后开始第三次总统任期。",
        "sourceIds": [
          "bio",
          "crs"
        ]
      },
      {
        "id": "event-03",
        "date": "2021",
        "title": "腐败定罪被撤销",
        "text": "最高法院确认审理法院缺乏管辖权，并另认定法官存在偏见，恢复其参选空间。",
        "sourceIds": [
          "court",
          "crs"
        ]
      },
      {
        "id": "event-04",
        "date": "2018",
        "title": "入狱并被排除参选",
        "text": "腐败定罪导致其入狱，未能参加当年总统选举；这些定罪随后被撤销。",
        "sourceIds": [
          "crs",
          "court"
        ]
      },
      {
        "id": "event-05",
        "date": "2006-10",
        "title": "赢得总统连任",
        "text": "在第二轮投票中再次当选，继续实施社会保障与发展政策。",
        "sourceIds": [
          "official-bio"
        ]
      },
      {
        "id": "event-06",
        "date": "2003-10",
        "title": "推出家庭补助计划",
        "text": "整合现金转移措施，以入学和健康服务等条件支持低收入家庭。",
        "sourceIds": [
          "worldbank"
        ]
      },
      {
        "id": "event-07",
        "date": "2003-01-01",
        "title": "首次就任总统",
        "text": "在2002年大选获胜后执政，成为巴西工会运动进入国家权力中心的重要转折。",
        "sourceIds": [
          "bio",
          "official-bio"
        ]
      },
      {
        "id": "event-08",
        "date": "1986",
        "title": "当选制宪议员",
        "text": "进入联邦众议院，参与民主转型后的制宪工作。",
        "sourceIds": [
          "bio",
          "chamber"
        ]
      },
      {
        "id": "event-09",
        "date": "1980",
        "title": "参与创立劳工党",
        "text": "与工会及社会运动力量共同创建劳工党，拓展劳工政治参与。",
        "sourceIds": [
          "bio",
          "official-bio"
        ]
      },
      {
        "id": "event-10",
        "date": "1978",
        "title": "领导金属工人罢工",
        "text": "在军事统治时期组织ABC工业区劳工行动，逐渐成为全国性工会领袖。",
        "sourceIds": [
          "official-bio"
        ]
      },
      {
        "id": "event-11",
        "date": "1963",
        "title": "完成车工职业训练",
        "text": "青年时期一边从事工厂劳动，一边接受SENAI训练，成为金属工人。",
        "sourceIds": [
          "chamber"
        ]
      },
      {
        "id": "event-12",
        "date": "1945-10-27",
        "title": "出生于伯南布哥州",
        "text": "童年随家人迁往圣保罗州，家庭迁徙与工业劳动塑造其早年经历。",
        "sourceIds": [
          "bio",
          "official-bio"
        ]
      }
