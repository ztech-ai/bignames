    "role": "国际发展经济学家 · 联合国环境署执行主任",
    "summary": "安诺生受过发展经济学训练，长期从事干旱、水资源、国际发展及环境治理工作。她在世界银行负责可持续发展与中东北非业务，2015至2019年领导世界自然保护联盟，随后出任联合国环境署执行主任。她推动将气候变化、自然丧失和污染作为相互关联的问题讨论，并倡导多边合作及将环境保护纳入发展决策。",
    "highlights": [
      {
        "id": "h1",
        "title": "领导联合国环境署",
        "text": "2019年起负责环境署工作，2023年获确认连任至2027年。",
        "sourceIds": [
          "s2",
          "s3"
        ]
      },
      {
        "id": "h2",
        "title": "连接自然保护与发展",
        "text": "历任世界银行及IUCN领导职务，将水资源、经济发展与生态保护联系起来。",
        "sourceIds": [
          "s2"
        ]
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "丹麦耶鲁普地区。"
      },
      {
        "id": "f2",
        "label": "教育与起步",
        "value": "取得伦敦北部理工学院学士及伦敦大学亚非学院发展经济学硕士学位。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2023-06-15",
        "title": "开始第二届环境署任期",
        "text": "经联合国大会确认，第二个四年任期开始，至2027年6月14日结束。",
        "sourceIds": [
          "s3"
        ]
      },
      {
        "id": "t2",
        "date": "2019-06",
        "title": "出任环境署执行主任",
        "text": "开始担任联合国副秘书长兼环境署负责人，机构总部位于内罗毕。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t3",
        "date": "2015-01",
        "title": "领导世界自然保护联盟",
        "text": "出任IUCN总干事，任至2019年，参与全球自然保护及可持续发展合作。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t4",
        "date": "2011",
        "title": "负责世界银行中东北非业务",
        "text": "担任该地区副行长，处理发展融资和地区发展议题。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t5",
        "date": "2010",
        "title": "负责世界银行可持续发展",
        "text": "担任可持续发展副行长，并领导国际农业研究磋商组织基金理事会。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t6",
        "date": "1999",
        "title": "加入世界银行",
        "text": "从联合国体系转入世界银行，随后担任多项领导职务。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t7",
        "date": "1992",
        "title": "协调阿拉伯地区水与环境工作",
        "text": "在联合国开发计划署负责阿拉伯地区水资源及环境协调。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t8",
        "date": "1982",
        "title": "完成发展经济学硕士学业",
        "text": "在伦敦大学亚非学院取得硕士学位，后来投身国际发展工作。",
        "sourceIds": [
