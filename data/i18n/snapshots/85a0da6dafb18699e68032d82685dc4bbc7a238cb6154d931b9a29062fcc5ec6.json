          "history"
        ]
      },
      {
        "id": "event-08",
        "date": "2007",
        "title": "奥巴贾纳水泥厂投产",
        "text": "集团开始尼日利亚水泥制造业务，为后来的非洲多国扩张建立生产基础。",
        "sourceIds": [
          "history"
        ]
      },
      {
        "id": "event-09",
        "date": "1978",
        "title": "开始大宗商品贸易",
        "text": "在开罗接受商业教育后，经营大米、糖和水泥贸易，后来逐步转向制造业。",
        "sourceIds": [
          "bio",
          "worldbank"
        ]
      },
