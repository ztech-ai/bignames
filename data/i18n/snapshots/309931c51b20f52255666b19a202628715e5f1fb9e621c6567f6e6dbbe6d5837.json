        "date": "2025-08-15",
        "title": "在阿拉斯加与特朗普会晤",
        "text": "在安克雷奇讨论乌克兰战争；会晤未达成停火或结束战争的协议。",
        "sourceIds": [
          "alaska"
        ]
      },
      {
        "id": "event-11",
        "date": "2024-05-07",
        "title": "开始第五届总统任期",
        "text": "在3月选举后宣誓就职，开启新的六年任期；反对派遭压制与乌克兰战争构成此次连任的重要背景。",
        "sourceIds": [
          "fifth",
          "fifth-ap"
        ]
      },
      {
        "date": "2023-03-17",
        "title": "国际刑事法院签发逮捕令",
        "text": "因涉嫌将乌克兰被占领地区儿童非法转移至俄罗斯的战争罪，被国际刑事法院签发逮捕令。",
        "sourceIds": [
          "icc"
        ],
        "id": "event-01"
      },
      {
        "date": "2022-02-24",
        "title": "俄罗斯全面入侵乌克兰",
        "text": "俄罗斯发动大规模入侵；联合国大会随后通过决议，要求结束入侵并无条件撤军。",
        "sourceIds": [
          "ap",
          "un"
        ],
        "id": "event-02"
      },
      {
        "date": "2014-03",
        "title": "吞并克里米亚",
        "text": "签署将克里米亚纳入俄罗斯的法律；联合国大会决议重申乌克兰领土完整，不承认相关公投效力。",
        "sourceIds": [
          "scr",
          "crimea"
        ],
        "id": "event-03"
      },
      {
        "date": "2012-03-04",
        "title": "再次当选俄罗斯总统",
        "text": "在担任总理四年后再次赢得总统选举，随后开始新一届总统任期。",
        "sourceIds": [
          "library"
        ],
        "id": "event-04"
      },
      {
        "date": "2008-05-08",
        "title": "转任俄罗斯总理",
        "text": "结束两届总统任期后担任总理，与时任总统梅德韦杰夫形成领导分工。",
        "sourceIds": [
          "mofa"
        ],
        "id": "event-05"
      },
      {
        "date": "2000-05-07",
        "title": "首次正式就任总统",
        "text": "在同年 3 月赢得总统选举后正式就职，2004 年再获连任。",
        "sourceIds": [
          "mofa"
        ],
        "id": "event-06"
      },
      {
        "date": "1999",
        "title": "从总理到代总统",
        "text": "8 月出任俄罗斯总理；12 月 31 日叶利钦辞职后，接任代总统。",
        "sourceIds": [
          "mofa"
        ],
        "id": "event-07"
      },
      {
        "date": "1998-07",
        "title": "出任联邦安全局局长",
        "text": "在中央总统机构任职后，担任联邦安全局局长，次年兼任安全会议秘书。",
        "sourceIds": [
          "mofa"
        ],
        "id": "event-08"
      },
      {
