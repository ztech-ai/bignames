          "s3"
        ],
        "title": "动态足式运动",
        "text": "通过Leg Laboratory研究跳跃、奔跑和平衡控制。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s1",
          "s5"
        ],
        "title": "从实验室走向应用",
        "text": "创办Boston Dynamics，推动具备复杂运动能力的机器人发展。"
      }
    ],
    "facts": [
