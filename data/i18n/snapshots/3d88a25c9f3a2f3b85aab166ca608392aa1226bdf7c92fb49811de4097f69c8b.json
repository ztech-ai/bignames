    "role": "机器人研究者、Robust.AI共同创办人兼技术负责人",
    "summary": "布鲁克斯主张从感知、行动和与环境的互动理解机器人智能，推动行为机器人学。他曾在MIT任教并领导人工智能实验室，参与创办iRobot、Rethink Robotics及Robust.AI，把研究转向家用和工业机器人，也经历了创业失败。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s2",
          "s6"
        ],
        "title": "从行为构建智能",
        "text": "以分层控制和真实环境互动挑战先建立完整世界模型再行动的路径，影响具身与自主机器人研究。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s1",
          "s4",
          "s5"
        ],
        "title": "让机器人进入实际工作",
        "text": "与团队把技术带入清洁、制造和物流等应用；Roomba、Baxter等产品的成功与限制均由工程、市场及运营共同塑造。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "澳大利亚阿德莱德。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "弗林德斯大学纯数学学位；1981年斯坦福大学计算机科学博士。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-01-01",
        "sourceIds": [
          "s3"
        ],
        "title": "更新技术预测记分表",
        "text": "回顾自动驾驶、机器人、AI及航天预测，明确区分此前判断、实际进展和新的个人预测。"
      },
      {
        "id": "t2",
        "date": "2019",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "共同创办Robust.AI",
        "text": "与合作者建立新机器人企业，继续研究能够在实际工作环境中运行的机器人系统。"
      },
      {
        "id": "t3",
        "date": "2018-10-03",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "Rethink Robotics停止原公司运营",
        "text": "2008年创办的公司结束运营；其协作机器人理念有影响，但商业生存未获保证。"
      },
      {
        "id": "t4",
        "date": "2012-09-18",
        "sourceIds": [
          "s5"
        ],
        "title": "推出Baxter协作机器人",
        "text": "Rethink团队发布可在人附近工作的双臂机器人，尝试简化制造业中的任务示教。"
      },
      {
        "id": "t5",
        "date": "2002",
        "sourceIds": [
          "s4"
        ],
        "title": "iRobot推出Roomba",
        "text": "其共同创办的公司发布家用吸尘机器人，把移动机器人技术带入消费市场。"
      },
      {
        "id": "t6",
        "date": "1990",
        "sourceIds": [
          "s1",
          "s4"
        ],
        "title": "共同创办iRobot",
        "text": "与Colin Angle、Helen Greiner成立公司，探索实际可用的移动机器人。"
      },
      {
        "id": "t7",
        "date": "1986-03",
        "sourceIds": [
          "s6"
        ],
        "title": "发表分层控制论文",
        "text": "在IEEE期刊阐述移动机器人的鲁棒分层控制，成为包容式架构及行为方法的重要文献。"
      },
      {
        "id": "t8",
        "date": "1984",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "加入MIT教职",
        "text": "在其他机构研究与任教后加入MIT，随后带领机器人研究并于1997年开始领导AI实验室。"
      },
      {
        "id": "t9",
        "date": "1981",
        "sourceIds": [
