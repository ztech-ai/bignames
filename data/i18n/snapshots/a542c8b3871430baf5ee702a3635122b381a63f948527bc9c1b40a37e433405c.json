    "role": "企业管理者、喜力监事会主席、ASML前首席执行官",
    "summary": "温宁克从会计审计进入半导体设备经营，先任ASML财务负责人，后与技术领导团队共同推动公司扩张及先进光刻设备产业化。2024年卸任后，他转向公司监督与投资政策咨询，现任喜力监事会主席。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s1",
          "s2",
          "s3"
        ],
        "title": "把财务管理与技术产业连接",
        "text": "在ASML从财务负责人升任首席执行官，与工程师、客户及供应商共同建设先进光刻设备业务。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s5"
        ],
        "title": "参与荷兰长期投资讨论",
        "text": "退休后提出国家投资与创新建议，把基础设施、人才和执行能力视为科技竞争的重要条件；建议不等于已完成投资。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "职业基础",
        "value": "在德勤从事审计与咨询，后来成为合伙人，专注高科技企业。"
      },
      {
        "id": "f2",
        "label": "专业训练",
        "value": "接受NIVRA会计与审计专业训练，具有注册会计师背景。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-05-22",
        "sourceIds": [
          "s6"
        ],
        "title": "监督喜力领导层交接",
        "text": "以监事会主席身份说明CEO遴选进展，强调业务连续性；其监督职能不同于日常执行管理。"
      },
      {
        "id": "t2",
        "date": "2025-12-12",
        "sourceIds": [
          "s5"
        ],
        "title": "发布温宁克报告",
        "text": "提交荷兰未来繁荣建议，列出四大战略领域及约1260亿欧元投资潜力，主要设想由私人部门融资。"
      },
      {
        "id": "t3",
        "date": "2025-04",
        "sourceIds": [
          "s1",
          "s7"
        ],
        "title": "出任喜力监事会主席",
        "text": "在此前加入监事会的基础上接任主席，负责对管理层的监督。"
      },
      {
        "id": "t4",
        "date": "2024-04-24",
        "sourceIds": [
          "s3"
        ],
        "title": "从ASML退休",
        "text": "结束总裁兼首席执行官任期，由Christophe Fouquet接任；长期技术合作伙伴Martin van den Brink同时退休。"
      },
      {
        "id": "t5",
        "date": "2013-07-01",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "升任ASML总裁兼CEO",
        "text": "由财务管理转向全面经营，与技术领导团队共同带领半导体设备公司发展。"
      },
      {
        "id": "t6",
        "date": "1999",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "加入ASML管理层",
        "text": "出任执行副总裁、财务负责人及管理委员会成员，把审计与产业客户经验带入公司。"
      },
      {
        "id": "t7",
        "date": "1993",
        "sourceIds": [
          "s4"
        ],
        "title": "成为德勤合伙人",
        "text": "在长期审计咨询工作后升任合伙人，逐渐形成高科技产业的财务与经营经验。"
      },
      {
