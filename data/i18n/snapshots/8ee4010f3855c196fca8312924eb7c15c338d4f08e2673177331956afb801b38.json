    "role": "半导体工程师、美光董事长兼首席执行官",
    "summary": "梅赫罗特拉从存储芯片设计起步，参与共同创办SanDisk，后来担任其总裁兼CEO并领导业务扩展。2017年转任美光CEO，2025年兼任董事长，在存储产业周期及AI需求变化中推动技术、产品和制造投入。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s1",
          "s4"
        ],
        "title": "从芯片设计到闪存产业",
        "text": "在工程岗位积累经验后与团队创建SanDisk，发展非易失性存储设计、系统与产品，帮助闪存进入大规模应用。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s3",
          "s5"
        ],
        "title": "领导资本密集的存储业务",
        "text": "在美光把工程、产品与全球制造结合，面对供需周期及客户需求；企业成果由研发、制造和经营团队共同完成。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "印度坎普尔。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "加州大学伯克利分校电气工程与计算机科学学士（1978）、硕士（1980）；后参加斯坦福高管课程。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-09-30",
        "sourceIds": [
          "s5"
        ],
        "title": "说明AI内存需求与投资",
        "text": "在2026财年业绩公告中以董事长兼CEO身份强调技术、产品及制造投资，并对下一财年提出预期，属于计划与判断。"
      },
      {
        "id": "t2",
        "date": "2025-01-16",
        "sourceIds": [
          "s3",
          "s4"
        ],
        "title": "兼任美光董事长",
        "text": "在年度股东大会后接替Bob Switz，与首席独立董事Lynn Dugle共同形成董事会领导安排。"
      },
      {
        "id": "t3",
        "date": "2017-05",
        "sourceIds": [
          "s2",
          "s4"
        ],
        "title": "出任美光CEO",
        "text": "加入美光担任总裁、首席执行官及董事，把长期闪存企业经验带入另一家存储厂商。"
      },
      {
        "id": "t4",
        "date": "2016-05",
        "sourceIds": [
          "s1",
          "s4"
        ],
        "title": "SanDisk出售给西部数据",
        "text": "公司并入Western Digital，他结束SanDisk总裁兼CEO任期，随后短暂担任西部数据董事参与整合。"
      },
      {
        "id": "t5",
        "date": "2011-01",
        "sourceIds": [
          "s1",
          "s4"
        ],
        "title": "升任SanDisk总裁兼CEO",
        "text": "接掌公司最高经营职责，继续推动闪存产品与系统业务发展。"
      },
      {
        "id": "t6",
        "date": "1988",
        "sourceIds": [
          "s1",
          "s4",
          "s6"
        ],
        "title": "共同创办SanDisk",
        "text": "与Eli Harari、Jack Yuan等创业者建立公司，探索以闪存实现固态存储的产业机会。"
      },
      {
        "id": "t7",
        "date": "1980",
        "sourceIds": [
          "s2",
          "s6"
        ],
        "title": "完成硕士并进入芯片设计",
        "text": "取得伯克利EECS硕士后在Intel设计EPROM，随后在多家半导体企业从事工程工作。"
      },
      {
        "id": "t8",
        "date": "1978",
        "sourceIds": [
          "s2"
        ],
        "title": "完成伯克利本科学业",
        "text": "取得EECS学士，为存储电路与系统工程生涯奠定基础。"
      }
