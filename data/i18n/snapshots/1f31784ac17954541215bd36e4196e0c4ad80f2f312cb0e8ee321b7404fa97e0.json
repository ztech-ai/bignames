    "role": "联合利华前首席执行官、利弗休姆信托基金主席",
    "summary": "乔普从联合利华营销培训生起步，先后管理北亚和美容个人护理业务，2019 至 2023 年任集团首席执行官。他的任内经历了消费品组合调整，也面对收购葛兰素史克消费者健康业务遭拒的挫折；离任后参与企业董事会与学术研究资助工作。",
    "highlights": [
      {
        "id": "h1",
        "title": "跨地区消费品管理",
        "text": "在英国、北美和亚洲积累营销与经营经验，由中国及北亚业务负责人升任美容个人护理业务总裁，最终出任联合利华首席执行官。",
        "sourceIds": [
          "s1",
          "s6"
        ]
      },
      {
        "id": "h2",
        "title": "转向董事会与研究资助",
        "text": "2023 年加入埃森哲董事会，2024 年起担任利弗休姆信托基金主席，参与企业治理及学术研究资助机构的领导工作。",
        "sourceIds": [
          "s1",
          "s3",
          "s4"
        ]
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "英国苏格兰格拉斯哥"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "爱丁堡大学商学荣誉学士；参加哈佛商学院综合管理课程，该课程并非 MBA 学位。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-09",
        "title": "以基金会主席身份访问牛津",
        "text": "随利弗休姆信托基金团队到访牛津人口科学研究中心，与研究人员讨论研究方向及该中心 2029 年之后的持续发展安排。",
        "sourceIds": [
          "s3"
        ]
      },
      {
        "id": "t2",
        "date": "2024-08",
        "title": "出任利弗休姆信托基金主席",
        "text": "自 2021 年担任受托人后，于 2024 年 8 月接任主席，参与这一英国学术研究资助机构的治理。",
        "sourceIds": [
          "s1",
          "s4"
        ]
      },
      {
        "id": "t3",
        "date": "2023",
        "title": "结束联合利华任期并进入新董事会",
        "text": "6 月底卸任联合利华首席执行官；同年 4 月加入埃森哲董事会，职业重心逐步转向非执行董事及公共事务工作。",
        "sourceIds": [
          "s1",
          "s2"
        ]
      },
      {
        "id": "t4",
        "date": "2022-01",
        "title": "消费者健康业务收购提案遭拒",
        "text": "联合利华提出约 500 亿英镑收购葛兰素史克消费者健康业务的方案遭拒；交易构想引发投资者对估值、债务和集团战略的质疑。",
        "sourceIds": [
          "s5"
        ]
      },
      {
        "id": "t5",
        "date": "2019-01-01",
        "title": "接任联合利华首席执行官",
        "text": "正式接替保罗·波尔曼，领导这家跨国消费品企业；这一任职延续至 2023 年 6 月。",
        "sourceIds": [
          "s6"
        ]
      },
      {
        "id": "t6",
        "date": "2014",
        "title": "领导美容个人护理业务",
        "text": "开始领导后来称为美容与个人护理的业务板块，在升任集团首席执行官之前管理联合利华的重要品牌组合。",
        "sourceIds": [
          "s6"
        ]
      },
      {
        "id": "t7",
        "date": "2009",
        "title": "负责中国及北亚业务",
        "text": "开始领导联合利华在中国和北亚的业务，扩展亚洲市场经营经验；2011 年进入集团领导执行团队。",
        "sourceIds": [
          "s6"
        ]
      },
      {
        "id": "t8",
        "date": "1985",
        "title": "以营销培训生加入联合利华",
        "text": "进入联合利华，随后在英国、泰国、美国等市场从事销售和营销，形成长期跨地区职业经历。",
