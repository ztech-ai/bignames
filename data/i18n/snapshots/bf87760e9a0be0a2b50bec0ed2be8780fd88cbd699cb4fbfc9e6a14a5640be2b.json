    "role": "建筑师 · 光、混凝土与场所",
    "summary": "安藤忠雄通过旅行、观察与自学进入建筑，以清水混凝土、几何墙体和光线组织内向而开放的空间。《住吉的长屋》《光之教堂》把日常与自然重新安排，直岛美术馆群把艺术、地形和行走经验相连。他也参与巴黎历史建筑改造，1995年获普利兹克建筑奖；其作品持续探索限制之中的自由和文化设施的公共意义。",
    "highlights": [
      {
        "id": "highlight-01",
        "title": "光线组织空间",
        "text": "《光之教堂》以简洁混凝土体量和十字形开口，让变化的自然光成为建筑体验的核心。",
        "sourceIds": [
          "benesse",
          "prize"
        ]
      },
      {
        "id": "highlight-02",
        "title": "艺术、地形与行走",
        "text": "直岛的地中美术馆及新美术馆把艺术展示与地形、自然光和行进路线结合。",
        "sourceIds": [
          "chichu",
          "newmuseum"
        ]
      }
    ],
    "facts": [
      {
        "id": "fact-01",
        "label": "出生地",
        "value": "日本大阪"
      },
      {
        "id": "fact-02",
        "label": "学习路径",
        "value": "自学建筑，通过旅行、阅读与现场观察建立实践"
      }
    ],
    "timeline": [
      {
        "id": "event-01",
        "date": "2026-06-12",
        "title": "回顾以光建造的实践",
        "text": "在Whitewall访谈中从大阪工作室谈几何、材料与人的体验，回顾直岛新美术馆等近作。",
        "sourceIds": [
          "recent"
        ]
      },
      {
        "id": "event-02",
        "date": "2025-05-31",
        "title": "直岛新美术馆开放",
        "text": "作为其在倍乐生艺术场所的第十座建筑，新馆以多层空间和自然光展示日本及亚洲当代艺术。",
        "sourceIds": [
          "newmuseum"
        ]
      },
      {
        "id": "event-03",
        "date": "2021",
        "title": "巴黎商业交易所改造开放",
        "text": "与法国修复和建筑团队合作，把混凝土圆筒置入历史建筑，形成艺术展览与原有空间的对话。",
        "sourceIds": [
          "paris"
        ]
      },
      {
        "id": "event-04",
        "date": "2004",
        "title": "地中美术馆在直岛开放",
        "text": "把大部分建筑埋入地形，以自然光和特定空间回应莫奈、詹姆斯·特瑞尔等艺术家的作品。",
        "sourceIds": [
          "chichu"
        ]
      },
      {
        "id": "event-05",
        "date": "1995",
        "title": "获得普利兹克建筑奖",
        "text": "评审肯定其以简洁几何、材料和光线创造丰富体验，也认可其自学形成的独立建筑实践。",
        "sourceIds": [
          "prize"
        ]
      },
      {
        "id": "event-06",
        "date": "1989",
        "title": "光之教堂建成",
        "text": "在大阪茨木以混凝土墙和十字开口形成祈祷空间，通过自然光强化身体与环境的感知。",
        "sourceIds": [
          "benesse"
        ]
      },
      {
        "id": "event-07",
        "date": "1979",
        "title": "住吉的长屋获建筑学会奖",
        "text": "这座紧凑住宅以开放庭院分隔室内生活，把雨、光和日常行走纳入城市住宅的体验。",
        "sourceIds": [
          "prize"
        ]
      },
      {
        "id": "event-08",
        "date": "1969",
        "title": "在大阪成立事务所",
        "text": "在旅行与自学之后建立独立事务所，从住宅项目开始发展对混凝土、几何和自然环境的探索。",
        "sourceIds": [
          "reference"
        ]
      },
      {
        "id": "event-09",
        "date": "1941-09-13",
        "title": "出生于大阪",
        "text": "在大阪出生，由祖母抚养，接触当地工匠的制作过程；青年时期曾从事拳击，后自学建筑。",
        "sourceIds": [
          "prize",
          "reference"
        ]
      }
