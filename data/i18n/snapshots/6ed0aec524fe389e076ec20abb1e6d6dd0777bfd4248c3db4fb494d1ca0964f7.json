    "role": "经济学家 · 格莱珉银行创办人 · 前临时政府首席顾问",
    "summary": "穆罕默德·尤努斯是孟加拉国经济学家和社会企业倡导者。他从乡村小额借贷实验发展出格莱珉银行，为缺乏抵押物的借款人提供金融服务，并与银行共享2006年诺贝尔和平奖。他也经历劳动法及贪腐诉讼。2024年政治动荡后领导临时政府，2026年2月任期结束。",
    "highlights": [
      {
        "id": "highlight-1",
        "title": "格莱珉银行",
        "text": "将1976年开始的乡村信贷实验发展为银行，推广面向贫困借款人的无传统抵押小额贷款。",
        "sourceIds": [
          "bank"
        ]
      },
      {
        "id": "highlight-2",
        "title": "共享诺贝尔和平奖",
        "text": "与格莱珉银行共同获得2006年和平奖，表彰从基层推动经济与社会发展的努力。",
        "sourceIds": [
          "mandela"
        ]
      }
    ],
    "facts": [
      {
        "id": "fact-1",
        "label": "出生地",
        "value": "英属印度吉大港地区巴图阿村，今属孟加拉国"
      },
      {
        "id": "fact-2",
        "label": "教育",
        "value": "达卡大学；1969年获范德堡大学经济学博士"
      }
    ],
    "timeline": [
      {
        "id": "event-1",
        "date": "2026-02-22",
        "title": "返回尤努斯中心",
        "text": "临时政府任期结束后返回尤努斯中心恢复工作，继续从事社会企业相关事务。",
        "sourceIds": [
          "return"
        ]
      },
      {
        "id": "event-2",
        "date": "2026-02-17",
        "title": "临时政府结束",
        "text": "选举后新政府就职，内阁部门公告解散顾问委员会，结束其约十八个月的过渡执政。",
        "sourceIds": [
          "handover"
        ]
      },
      {
        "id": "event-3",
        "date": "2024-08-08",
        "title": "领导临时政府",
        "text": "哈西娜政府倒台后宣誓就任首席顾问，在学生抗议后的政治转折中领导过渡政府。",
        "sourceIds": [
          "legal2",
          "return"
        ]
      },
      {
        "id": "event-4",
        "date": "2024-08",
        "title": "两宗案件获无罪处理",
        "text": "劳动法案件定罪于7日被推翻，11日另一宗贪腐案获无罪处理；这些是特定案件结果。",
        "sourceIds": [
          "legal",
          "legal2"
        ]
      },
      {
        "id": "event-5",
        "date": "2006",
        "title": "获得诺贝尔和平奖",
        "text": "与格莱珉银行共同获奖，使基层金融服务与减贫理念得到更广泛国际关注。",
        "sourceIds": [
          "mandela"
        ]
      },
      {
        "id": "event-6",
        "date": "1983",
        "title": "格莱珉成为独立银行",
        "text": "此前的行动研究项目发展为正式银行，持续向传统银行难以覆盖的贫困群体提供贷款。",
        "sourceIds": [
          "bank"
        ]
      },
      {
        "id": "event-7",
        "date": "1976",
        "title": "开展乡村借贷实验",
        "text": "在吉大港大学附近的乔布拉村调查借贷困境，以小额资金帮助村民摆脱高利借贷依赖。",
        "sourceIds": [
          "bank"
        ]
      },
      {
