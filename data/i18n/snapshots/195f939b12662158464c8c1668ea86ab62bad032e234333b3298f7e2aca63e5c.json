        "date": "1989",
        "title": "量子密码演示",
        "text": "与斯莫林、布拉萨尔及学生合作完成早期BB84实验演示。",
        "sourceIds": [
          "s2"
        ]
      },
      {
        "id": "t4",
        "date": "1984",
        "title": "提出BB84",
        "text": "与布拉萨尔发表量子密码协议，成为量子密钥分发的重要基础。",
        "sourceIds": [
          "s1"
        ]
      },
      {
        "id": "t5",
        "date": "1982",
        "title": "重释麦克斯韦妖",
        "text": "把无法违反热力学第二定律的原因联系于信息擦除的代价。",
        "sourceIds": [
          "s6"
        ]
      },
      {
        "id": "t6",
        "date": "1973",
        "title": "可逆计算论文",
        "text": "分析逻辑可逆计算，说明计算步骤并非必然伴随固定能量耗散。",
