    "role": "Netflix联合创始人、前CEO与前董事长",
    "summary": "里德·哈斯廷斯与马克·伦道夫共同创办Netflix，推动业务从邮寄DVD租赁转向流媒体订阅、原创节目与全球发行，改变影视观看和分发方式。他也经历过Qwikster拆分失误及用户反弹。2023年卸任CEO、2026年离开董事会；另通过教育捐赠及加入Anthropic董事会参与技术与社会议题。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s4",
          "s7"
        ],
        "title": "从DVD走向流媒体",
        "text": "与团队把线上租碟业务发展为流媒体平台，通过订阅与全球发行改变影视消费方式。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s11",
          "s12"
        ],
        "title": "教育与技术治理",
        "text": "支持教育慈善及鲍登学院AI与人类研究；2025年获Anthropic长期利益信托任命为公司董事。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "美国马萨诸塞州波士顿"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "鲍登学院数学学士；斯坦福大学计算机科学硕士"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-06-04",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "离开Netflix董事会",
        "text": "任期在年度股东会结束后届满，Jay Hoag接任董事长；此前2025年已转为非执行董事长。"
      },
      {
        "id": "t2",
        "date": "2023-01-13",
        "sourceIds": [
          "s3"
        ],
        "title": "卸任联合CEO",
        "text": "转任执行董事长，Greg Peters与Ted Sarandos共同领导公司；这一变动在1月19日公开宣布。"
      },
      {
        "id": "t3",
        "date": "2016-01-06",
        "sourceIds": [
          "s4"
        ],
        "title": "大规模国际扩展",
        "text": "在CES宣布服务进入130多个新国家，覆盖显著扩大，但仍未进入中国等部分市场。"
      },
      {
        "id": "t4",
        "date": "2013-02-01",
        "sourceIds": [
          "s5"
        ],
        "title": "《纸牌屋》上线",
        "text": "Netflix一次推出首季13集，成为其原创节目与整季观看模式的重要节点；作品由创作与制作团队完成。"
      },
      {
        "id": "t5",
        "date": "2011-10-10",
        "sourceIds": [
          "s6"
        ],
        "title": "放弃Qwikster拆分",
        "text": "涨价及拟分拆DVD业务引发反弹后，公司撤销品牌拆分；哈斯廷斯此前已为沟通失误道歉。"
      },
      {
        "id": "t6",
        "date": "2007-01-16",
        "sourceIds": [
          "s7"
        ],
        "title": "推出电脑即时观看",
        "text": "Netflix宣布分阶段向会员提供网络观影，同时保留邮寄DVD业务，开启流媒体转型。"
      },
      {
        "id": "t7",
        "date": "2002-05-23",
        "sourceIds": [
          "s8"
        ],
        "title": "Netflix在纳斯达克上市",
        "text": "公司股票以NFLX代码开始交易，为业务发展融资。"
      },
      {
        "id": "t8",
        "date": "1997",
        "sourceIds": [
          "s9"
        ],
        "title": "共同创办Netflix",
        "text": "与马克·伦道夫建立公司，随后于1998年推出线上DVD租赁服务。"
      },
      {
        "id": "t9",
        "date": "1991",
        "sourceIds": [
          "s9",
          "s10"
        ],
        "title": "创办Pure Software",
        "text": "进入软件开发工具创业；公司经历上市与合并后于1997年被Rational收购。"
      },
      {
        "id": "t10",
        "date": "1988",
        "sourceIds": [
          "s9",
          "s10"
        ],
        "title": "完成斯坦福硕士",
        "text": "取得计算机科学硕士；此前1983年获鲍登数学学士，并在斯威士兰任和平队数学教师。"
      }
