      }
    ],
    "timeline": [
      {
        "id": "event-01",
        "date": "2026-05-07",
        "title": "纽约《Landschaften》展览开幕",
        "text": "与艺术家密切合作策划的风景展，将照片式风景与抽象绘画并置，展出其私人收藏借件。",
        "sourceIds": [
