        "sourceIds": [
          "retrospective"
        ]
      },
      {
        "id": "event-03",
        "date": "2014",
        "title": "完成《比克瑙》组画",
        "text": "从集中营照片出发，通过覆盖和抽象转化处理大屠杀记忆，讨论图像与不可再现之物的关系。",
        "sourceIds": [
          "gallery"
        ]
      },
      {
        "id": "event-04",
        "date": "2007",
        "title": "科隆大教堂彩窗揭幕",
        "text": "以大量彩色方格组成南耳堂窗，将色彩、偶然性与宗教建筑中的光线体验结合。",
        "sourceIds": [
          "reference",
          "award"
        ]
      },
      {
        "id": "event-05",
        "date": "1988",
        "title": "创作《1977年10月18日》",
        "text": "根据红军派相关新闻照片绘制十五幅灰色画作，以模糊图像审视政治暴力与记忆。",
        "sourceIds": [
          "moma"
        ]
      },
      {
        "id": "event-06",
        "date": "1972",
        "title": "在威尼斯展出《48幅肖像》",
        "text": "以男性文化与知识人物的照片为基础绘制成组肖像，在德国馆中讨论肖像和文化记忆。",
        "sourceIds": [
          "retrospective"
        ]
      },
      {
        "id": "event-07",
        "date": "1963",
        "title": "参与“资本主义现实主义”展示",
        "text": "与波尔克、吕格等人合作，以对消费图像和现实主义的反思，探索战后西德艺术的位置。",
        "sourceIds": [
          "award"
        ]
      },
      {
        "id": "event-08",
        "date": "1961",
        "title": "离开东德赴杜塞尔多夫",
        "text": "迁往西德并重新进入艺术学院学习，在不同艺术制度与图像文化之间重建自己的绘画实践。",
        "sourceIds": [
          "award"
        ]
      },
      {
        "id": "event-09",
        "date": "1951",
        "title": "进入德累斯顿艺术学院",
        "text": "学习壁画，在东德艺术教育中接受训练；之后的跨境经历促使其重新思考图像和绘画。",
        "sourceIds": [
          "cv"
        ]
      },
