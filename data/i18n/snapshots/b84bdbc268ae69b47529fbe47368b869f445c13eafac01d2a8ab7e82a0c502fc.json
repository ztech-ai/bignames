      {
        "date": "2019-12-03",
        "title": "卸任 Alphabet 首席执行官",
        "text": "与布林共同宣布调整管理结构，由桑达尔·皮查伊兼任 Google 与 Alphabet 首席执行官。",
        "sourceIds": [
          "letter"
        ],
        "id": "event-01"
      },
      {
        "date": "2015",
        "title": "出任 Alphabet 首席执行官",
        "text": "Google 重组为 Alphabet 旗下企业，佩奇转而负责新集团，皮查伊接任 Google 首席执行官。",
        "sourceIds": [
          "mit",
          "letter"
        ],
        "id": "event-02"
      },
      {
        "date": "2011-04-04",
        "title": "重新负责 Google 日常运营",
        "text": "接替埃里克·施密特出任首席执行官，同时承担产品与技术战略职责。",
