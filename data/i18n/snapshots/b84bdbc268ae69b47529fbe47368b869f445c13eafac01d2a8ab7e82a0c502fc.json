        ],
        "id": "event-05"
      },
      {
        "date": "2001",
        "title": "管理分工调整",
        "text": "埃里克·施密特成为首席执行官；佩奇转任产品负责人，继续参与企业领导。",
        "sourceIds": [
          "mit"
        ],
        "id": "event-06"
      },
      {
        "date": "1998",
        "title": "共同创办 Google",
        "text": "与布林将搜索研究商业化，获得早期投资，并在加州车库建立办公室。",
