          "history"
        ],
        "id": "event-02"
      },
      {
        "date": "2012",
        "title": "GPU 支持深度学习突破",
        "text": "AlexNet 神经网络利用 NVIDIA GPU 训练，成为深度学习发展的标志性事件。",
        "sourceIds": [
          "history"
        ],
        "id": "event-03"
      },
      {
        "date": "2006",
        "title": "公布 CUDA 架构",
        "text": "将 GPU 的并行处理能力扩展到图形之外，为科学计算和后来的 AI 生态奠定基础。",
        "sourceIds": [
          "history"
        ],
        "id": "event-04"
      },
      {
        "date": "1999",
        "title": "GPU 产品成为关键方向",
        "text": "NVIDIA 将图形处理器作为核心产品方向，推动个人电脑图形计算的发展。",
        "sourceIds": [
          "history"
        ],
        "id": "event-05"
      },
      {
        "date": "1993-04-05",
        "title": "与两位伙伴共同创业",
        "text": "与 Chris Malachowsky、Curtis Priem 创立 NVIDIA，面向游戏和多媒体的三维图形市场。",
        "sourceIds": [
          "history"
        ],
        "id": "event-06"
      },
      {
        "date": "1992",
        "title": "取得斯坦福大学硕士学位",
        "text": "在完成本科教育并进入芯片行业后，获得斯坦福大学电气工程硕士学位。",
