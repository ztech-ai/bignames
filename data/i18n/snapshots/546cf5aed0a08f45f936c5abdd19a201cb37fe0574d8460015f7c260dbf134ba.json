    "role": "实验物理学家 · 大型科学工程组织者",
    "summary": "巴里什在加州大学伯克利分校接受物理训练，长期任教于加州理工学院，早期从事粒子及中微子实验。1994年起领导LIGO的建设与组织，推动跨机构合作及探测器实施；合作团队于2015年首次直接探测引力波。2017年他与韦斯、索恩分享诺贝尔物理学奖，后来赴石溪大学任教。",
    "highlights": [
      {
        "id": "h1",
        "title": "建设LIGO",
        "text": "组织探测器建设和国际合作，使长期研究计划成为可运行的观测设施。",
        "sourceIds": [
          "s1",
          "s2"
        ]
      },
      {
        "id": "h2",
        "title": "共享诺贝尔奖",
        "text": "与雷纳·韦斯、基普·索恩分享2017年物理学奖；引力波观测是合作团队成果。",
        "sourceIds": [
          "s3"
        ]
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "美国内布拉斯加州奥马哈，1936年生。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "加州大学伯克利分校学士（1957）、物理学博士（1962）。"
      }
    ],
    "timeline": [
