    "role": "经济学家 · 前美联储主席与财政部长",
    "summary": "珍妮特·耶伦以失业与宏观经济研究进入学界和公共政策领域。她先后领导旧金山联储、美联储及美国财政部，是首位担任后两项职务的女性。其公共生涯跨越金融危机后的复苏与疫情后的通胀，兼顾就业、价格稳定和国际经济协调；她亦承认曾低估通胀走势，体现经济决策的不确定性。",
    "highlights": [
      {
        "id": "highlight-01",
        "title": "突破经济政策领导层壁垒",
        "text": "成为首位女性美联储主席和美国财政部长，并曾领导白宫经济顾问委员会。",
        "sourceIds": [
          "treasury",
          "fed"
        ]
      },
      {
        "id": "highlight-02",
        "title": "从就业研究走向政策实践",
        "text": "研究失业的成因与影响，在学术、中央银行和财政政策机构之间长期工作。",
        "sourceIds": [
          "brookings",
          "fed"
        ]
      }
    ],
    "facts": [
      {
        "id": "fact-01",
        "label": "出生地",
        "value": "美国纽约布鲁克林"
      },
      {
        "id": "fact-02",
        "label": "教育",
        "value": "布朗大学经济学学士（1967）；耶鲁大学经济学博士（1971）"
      }
    ],
    "timeline": [
      {
        "id": "event-01",
        "date": "2026-09-10",
        "title": "分享经济政策与领导经验",
        "text": "伯克利哈斯发布与她的长篇对谈，回顾从大学任教到华盛顿公共服务的经历。",
        "sourceIds": [
          "current"
        ]
      },
      {
        "id": "event-02",
        "date": "2025",
        "title": "结束财政部长任期",
        "text": "离开财政部后回到布鲁金斯研究工作；该任期从2021年延续至2025年。",
        "sourceIds": [
          "treasury",
          "brookings"
        ]
      },
      {
        "id": "event-03",
        "date": "2022-05-31",
        "title": "承认低估通胀走势",
        "text": "在采访中表示此前对通胀路径的判断有误，并支持美联储采取行动抑制价格上涨。",
        "sourceIds": [
          "inflation"
        ]
      },
      {
        "id": "event-04",
        "date": "2021-01-26",
        "title": "宣誓就任财政部长",
        "text": "成为美国首位女性财政部长，将中央银行经验带入疫情时期的经济政策工作。",
        "sourceIds": [
          "treasury"
        ]
      },
      {
        "id": "event-05",
        "date": "2014-02-03",
        "title": "出任美联储主席",
        "text": "接替伯南克，成为首位领导美联储的女性，任职至2018年2月。",
        "sourceIds": [
          "fed"
        ]
      },
      {
        "id": "event-06",
        "date": "2010",
        "title": "出任美联储副主席",
        "text": "从旧金山联储转任理事会副主席，参与金融危机后的货币政策。",
        "sourceIds": [
          "fed"
        ]
      },
      {
        "id": "event-07",
        "date": "2004",
        "title": "领导旧金山联储",
        "text": "出任旧金山联邦储备银行行长兼首席执行官，任职至2010年。",
        "sourceIds": [
          "fed"
        ]
      },
      {
        "id": "event-08",
        "date": "1997",
        "title": "领导总统经济顾问委员会",
        "text": "离开美联储理事会，担任白宫经济顾问委员会主席至1999年。",
        "sourceIds": [
          "fed",
          "brookings"
        ]
      },
      {
        "id": "event-09",
        "date": "1980",
        "title": "加入加州大学伯克利分校",
        "text": "在哈佛、联储和伦敦经济学院工作后加入伯克利，将失业研究与教学结合。",
        "sourceIds": [
          "fed"
        ]
      },
      {
        "id": "event-10",
        "date": "1971",
        "title": "取得耶鲁经济学博士",
        "text": "完成博士学位后到哈佛大学任教，开启宏观经济学研究生涯。",
        "sourceIds": [
          "fed",
          "brookings"
        ]
