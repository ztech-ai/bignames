        ],
        "title": "拓展精准编辑工具",
        "text": "团队发展的碱基编辑与先导编辑扩大了DNA定点替换、插入和删除的技术选择。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s1",
          "s2"
        ],
        "title": "从基础研究走向应用",
        "text": "相关工具进入多项临床试验；他先后获得2025年生命科学突破奖与2026年鲍尔科学成就奖。"
      }
    ],
