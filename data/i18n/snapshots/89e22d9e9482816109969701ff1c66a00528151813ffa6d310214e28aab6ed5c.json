    "role": "滑雪运动员 · 高山滑雪世界杯纪录创造者",
    "summary": "希弗林少年时期进入高山滑雪世界杯，以精细的回转技术成名，后来把成绩拓展至大回转、超级大回转等项目。她十八岁获得索契奥运回转金牌，2023年超越斯滕马克的世界杯胜场纪录，2025年率先达到一百胜。伤病与复出考验贯穿其生涯；2026年她再获奥运回转金牌，并赢得第六座世界杯年度总冠军。",
    "facts": [
      {
        "id": "fact-1",
        "label": "训练经历",
        "value": "伯克山学院；韦尔滑雪与单板滑雪俱乐部"
      },
      {
        "id": "fact-2",
        "label": "主要项目",
        "value": "回转、大回转，也参加速度项目"
      }
    ],
    "highlights": [
      {
        "id": "highlight-1",
        "title": "世界杯百胜里程碑",
        "text": "2025年2月在塞斯特雷回转赛取胜，成为首位累计赢得一百场高山滑雪世界杯比赛的运动员。",
        "sourceIds": [
          "hundred"
        ]
      },
      {
        "id": "highlight-2",
        "title": "三枚奥运金牌与六次年度冠军",
        "text": "截至2026年3月，拥有三枚奥运金牌和六座世界杯年度总冠军，体现跨赛季与项目的竞争力。",
        "sourceIds": [
          "olympics2026",
          "overall"
        ]
      }
    ],
    "timeline": [
      {
        "id": "event-1",
        "date": "2026-10-24",
        "title": "新赛季索尔登第七名",
        "text": "在索尔登世界杯大回转揭幕战获得第七名，开始减少回转、加强大回转及超级大回转的探索赛季。",
        "sourceIds": [
          "results",
          "current"
        ]
      },
      {
        "id": "event-2",
        "date": "2026-03-25",
        "title": "第六座世界杯年度总冠军",
        "text": "在挪威赛季收官战后赢得第六座女子年度总冠军，追平莫泽-普勒尔保持的女子纪录。",
        "sourceIds": [
          "overall",
          "overall-independent"
        ]
      },
      {
        "id": "event-3",
        "date": "2026-02-18",
        "title": "第三枚奥运金牌",
        "text": "在米兰—科尔蒂纳冬奥会回转赛夺金，继2014年回转和2018年大回转后获得第三枚奥运金牌。",
        "sourceIds": [
          "olympics2026",
          "teamusa"
        ]
      },
      {
        "id": "event-4",
        "date": "2025-02-23",
        "title": "世界杯第一百场胜利",
        "text": "在腹部受伤并休赛后赢得塞斯特雷回转赛，成为高山滑雪世界杯首位百胜运动员。",
        "sourceIds": [
          "hundred"
        ]
      },
      {
        "id": "event-5",
        "date": "2023-03-11",
        "title": "超越斯滕马克胜场纪录",
        "text": "在瑞典奥勒赢得第八十七场世界杯比赛，超过斯滕马克的八十六胜，成为该系列赛胜场纪录保持者。",
        "sourceIds": [
          "us-ski"
        ]
      },
      {
        "id": "event-6",
        "date": "2018-02",
        "title": "平昌奥运一金一银",
        "text": "在平昌冬奥会赢得大回转金牌和全能银牌，把奥运成绩从回转拓展至其他高山项目。",
        "sourceIds": [
          "teamusa"
        ]
