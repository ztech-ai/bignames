    "role": "计算机科学家、林茨开普勒大学教授、NXAI共同创办人",
    "summary": "霍赫赖特研究神经网络的长期依赖与学习机制，早期分析梯度消失问题，并与于尔根·施米德胡伯共同提出LSTM。此后在林茨开展机器学习、生物信息学及AI研究，近年与团队探索xLSTM、时间序列模型TiRex及产业应用。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s8",
          "s9"
        ],
        "title": "让网络学习长期依赖",
        "text": "其梯度分析揭示深层及循环网络训练的困难，后来与施米德胡伯用记忆单元和门控发展LSTM，而非由一人独力完成整个领域。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s3",
          "s4",
          "s5"
        ],
        "title": "延续循环模型研究",
        "text": "与多名研究者提出xLSTM和TiRex，研究可扩展语言建模与时间序列预测；实验结果有具体任务和测试条件。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "德国巴伐利亚州因河畔米尔多夫。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "慕尼黑工业大学计算机科学Diplom及博士；另曾学习数学。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2026-08-17",
        "sourceIds": [
          "s2"
        ],
        "title": "讲述AI下一阶段",
        "text": "在FAU演讲中讨论xLSTM、TiRex及机器人记忆，主办方随后发布录像；这些方向仍属于持续研究。"
      },
      {
        "id": "t2",
        "date": "2025-05-29",
        "sourceIds": [
          "s4"
        ],
        "title": "发表TiRex预印本",
        "text": "与Andreas Auer等合作者提出基于xLSTM的时间序列基础模型，研究短期及长期的零样本预测。"
      },
      {
        "id": "t3",
        "date": "2024-05-07",
        "sourceIds": [
          "s3"
        ],
        "title": "发表xLSTM预印本",
        "text": "与团队公开扩展LSTM架构，用指数门控和不同记忆结构研究大规模序列建模。"
      },
      {
        "id": "t4",
        "date": "2023-12",
        "sourceIds": [
          "s5"
        ],
        "title": "共同创办NXAI",
        "text": "参与2023年12月成立的公司，随后与JKU宣布研究合作，寻求把AI成果转向产业应用。"
      },
      {
        "id": "t5",
        "date": "2017",
        "sourceIds": [
          "s6"
        ],
        "title": "领导LIT AI Lab",
        "text": "开始领导林茨技术研究院人工智能实验室，把机器学习与跨学科研究结合。"
      },
      {
        "id": "t6",
        "date": "2006",
        "sourceIds": [
          "s6",
          "s7"
        ],
        "title": "赴林茨任教授",
        "text": "在慕尼黑、科罗拉多和柏林研究后，成为JKU生物信息学教授，后来转向机器学习研究所领导工作。"
      },
      {
        "id": "t7",
        "date": "1997",
        "sourceIds": [
          "s7",
          "s8"
        ],
        "title": "共同发表LSTM",
        "text": "与施米德胡伯在《Neural Computation》发表长短期记忆网络研究，为长序列学习提供重要架构。"
      },
      {
        "id": "t8",
        "date": "1991",
        "sourceIds": [
          "s7",
          "s9"
        ],
        "title": "完成早期神经网络论文",
        "text": "在慕尼黑工业大学Diplom论文中分析动态神经网络训练及梯度问题，形成其长期依赖研究的起点。"
      }
