    "role": "游泳运动员 · 长距离自由泳冠军",
    "summary": "莱德基从美国青少年游泳体系成长，十五岁即在伦敦奥运会赢得800米自由泳金牌。她以配速、耐力和长期训练积累统治女子中长距离项目，多次刷新长池世界纪录。到2024年巴黎奥运会结束时，她共获九金、十四枚奥运奖牌；2025年再破800米世界纪录并夺世锦赛冠军，2026年仍在国际大赛中竞争。",
    "facts": [
      {
        "id": "fact-1",
        "label": "出生地",
        "value": "美国华盛顿哥伦比亚特区"
      },
      {
        "id": "fact-2",
        "label": "大学",
        "value": "斯坦福大学；心理学学士"
      }
    ],
    "highlights": [
      {
        "id": "highlight-1",
        "title": "跨四届奥运会夺金",
        "text": "从2012年伦敦至2024年巴黎连续四届赢得800米自由泳，巴黎赛后奥运奖牌累计十四枚。",
        "sourceIds": [
          "medals",
          "paris"
        ]
      },
      {
        "id": "highlight-2",
        "title": "长池800米世界纪录",
        "text": "2025年5月在劳德代尔堡游出8分04秒12，刷新自己保持近九年的800米长池世界纪录。",
        "sourceIds": [
          "record",
          "record-independent"
        ]
      }
    ],
    "timeline": [
      {
        "id": "event-1",
        "date": "2026-08-15",
        "title": "泛太平洋800米获银牌",
        "text": "在尔湾泛太平洋锦标赛以8分07秒26获得800米自由泳银牌，冠军由澳大利亚的帕利斯特取得。",
        "sourceIds": [
          "current",
          "rankings"
        ]
      },
      {
        "id": "event-2",
        "date": "2025-08-02",
        "title": "第七座800米世锦赛冠军",
        "text": "在新加坡世锦赛赢得800米自由泳，取得该项目第七座世界冠军，延续其长期大赛竞争力。",
        "sourceIds": [
          "worlds"
        ]
      },
      {
        "id": "event-3",
        "date": "2025-05-03",
        "title": "刷新800米长池世界纪录",
        "text": "在劳德代尔堡职业游泳系列赛游出8分04秒12，打破自己于2016年里约创造的纪录。",
        "sourceIds": [
          "record",
          "record-independent"
        ]
      },
      {
        "id": "event-4",
        "date": "2024-08-03",
        "title": "巴黎后累计九枚奥运金牌",
        "text": "在巴黎赢得800米和1500米自由泳；四届奥运会合计九金、四银、一铜，共十四枚奖牌。",
        "sourceIds": [
          "medals",
          "paris"
        ]
      },
      {
        "id": "event-5",
        "date": "2021-09-22",
        "title": "转往佛罗里达训练",
        "text": "宣布离开斯坦福训练体系，前往盖恩斯维尔与安东尼·内斯蒂合作，并加入大学的志愿教练团队。",
