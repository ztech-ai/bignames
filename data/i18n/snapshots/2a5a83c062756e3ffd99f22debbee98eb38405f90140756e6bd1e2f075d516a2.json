    "role": "建筑师 · BIG创始人",
    "summary": "英格尔斯在丹麦与西班牙接受建筑训练，曾在OMA工作，与朱利安·德斯梅特创办PLOT，后建立独立的BIG公司。他以住宅、公共设施和城市项目组合不同用途，把环境目标与日常体验联系起来。8字住宅、VIA 57 West和CopenHill均由团队及工程合作者完成，其实践也通过展览、出版和国际教学传播。",
    "highlights": [
      {
        "id": "h1",
        "title": "混合建筑用途",
        "text": "团队把住宅、商业、公共活动等用途结合，探索城市空间的不同组织方式。",
        "sourceIds": [
          "s1"
        ]
      },
      {
        "id": "h2",
        "title": "环境目标与体验",
        "text": "CopenHill将垃圾能源设施与屋顶滑雪等活动结合，体现其设计主张。",
        "sourceIds": [
          "s1"
        ]
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "丹麦格洛斯楚普。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "在丹麦皇家艺术学院建筑学校及巴塞罗那ETSAB学习；1999年完成建筑学业。"
      }
    ],
    "timeline": [
