      }
    ],
    "timeline": [
      {
        "id": "t1",
        "title": "出版母女回忆录",
        "text": "《Mother Mary Comes to Me》出版后，她在访谈中讨论与母亲玛丽·罗伊的复杂关系。",
        "sourceIds": [
          "s2"
        ],
        "date": "2025-09"
