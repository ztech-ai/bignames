        "sourceIds": [
          "s3"
        ],
        "id": "event-03"
      },
      {
        "date": "2011",
        "title": "获得拉斯克临床医学研究奖",
        "text": "获奖表彰其在青蒿素发现与疟疾治疗方面的贡献。",
