        ],
        "id": "event-04"
      },
      {
        "date": "1986",
        "title": "青蒿素获得新药证书",
        "text": "研究成果进入药品审批与推广阶段，后续衍生物开发继续推进。",
        "sourceIds": [
          "s1"
        ],
        "id": "event-05"
      },
      {
        "date": "1981",
        "title": "向国际同行报告成果",
        "text": "在由国际机构支持的抗疟专题会议上介绍青蒿素及衍生物研究。",
        "sourceIds": [
          "s2"
        ],
        "id": "event-06"
      },
      {
        "date": "1973",
        "title": "研究双氢青蒿素",
        "text": "在结构研究中得到双氢青蒿素，为后续青蒿素类药物发展提供基础。",
        "sourceIds": [
          "s2"
        ],
        "id": "event-07"
      },
      {
        "date": "1972",
        "title": "分离青蒿素并开展临床验证",
        "text": "团队获得有效成分的纯品，同时推进早期患者试验。",
