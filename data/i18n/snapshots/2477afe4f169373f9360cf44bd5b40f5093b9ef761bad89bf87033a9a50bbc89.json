    "role": "甲骨文董事会执行副董事长、前首席执行官",
    "summary": "卡茨以投资银行、财务管理和并购经验参与甲骨文的长期扩张，历任总裁、财务负责人及首席执行官。2025年9月，她把CEO职责交给Clay Magouyrk和Mike Sicilia，转任董事会执行副董事长，继续参与公司方向与治理。",
    "highlights": [
      {
        "id": "h1",
        "sourceIds": [
          "s3"
        ],
        "title": "把交易与经营结合",
        "text": "她在甲骨文推动收购战略、财务管理与运营整合，把投行经验转化为企业软件公司的管理能力。"
      },
      {
        "id": "h2",
        "sourceIds": [
          "s2",
          "s3"
        ],
        "title": "领导云业务转型与交接",
        "text": "作为CEO参与公司向云服务扩张，随后转任执行副董事长；技术开发与工程由其他领导及团队共同负责。"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "label": "出生地",
        "value": "以色列霍隆。"
      },
      {
        "id": "f2",
        "label": "教育",
        "value": "1983年宾夕法尼亚大学沃顿商学院学士；1986年宾大法学院法律博士。"
      }
    ],
    "timeline": [
      {
        "id": "t1",
        "date": "2025-09-22",
        "sourceIds": [
          "s2",
          "s3"
        ],
        "title": "转任执行副董事长",
        "text": "结束CEO任期，Magouyrk和Sicilia共同接任；新职位使她继续参与董事会及战略工作。"
      },
      {
        "id": "t2",
        "date": "2019-10",
        "sourceIds": [
          "s7"
        ],
        "title": "成为唯一CEO",
        "text": "共同CEO Mark Hurd去世后，她独自担任该职，延续公司日常经营领导。"
      },
      {
        "id": "t3",
        "date": "2014-09",
        "sourceIds": [
          "s4"
        ],
        "title": "获任共同CEO",
        "text": "Larry Ellison转向执行董事长与技术职责，她与Hurd共同担任CEO，分担经营责任。"
      },
      {
        "id": "t4",
        "date": "2011-04",
        "sourceIds": [
          "s3"
        ],
        "title": "再次担任财务负责人",
        "text": "重任CFO，并兼任总裁，继续负责财务与经营管理，直至2014年职责调整。"
      },
      {
        "id": "t5",
        "date": "2004-01",
        "sourceIds": [
          "s3",
          "s4"
        ],
        "title": "出任甲骨文总裁",
        "text": "进入公司最高经营管理层，后来兼任多个时期的财务负责人。"
      },
      {
        "id": "t6",
        "date": "2001-10",
        "sourceIds": [
          "s4"
        ],
        "title": "加入董事会",
        "text": "成为甲骨文董事，把经营职责与董事会治理结合。"
      },
      {
        "id": "t7",
        "date": "1999-04",
        "sourceIds": [
          "s6",
          "s7"
        ],
        "title": "加入甲骨文",
        "text": "结束在Donaldson, Lufkin & Jenrette的投行工作，转入企业软件公司管理。"
      },
      {
        "id": "t8",
        "date": "1986",
        "sourceIds": [
          "s5",
          "s6"
        ],
        "title": "完成法律教育并进入投行",
        "text": "取得宾大法律博士后开始投资银行生涯，后来升任董事总经理。"
      },
      {
        "id": "t9",
        "date": "1983",
        "sourceIds": [
