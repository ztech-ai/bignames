        "label": "出生地",
        "value": "蒙罗维亚，利比里亚"
      },
      {
        "id": "fact-02",
        "label": "教育",
        "value": "哈佛大学肯尼迪政府学院公共管理硕士（1971）"
      }
    ],
    "highlights": [
      {
        "id": "highlight-01",
        "title": "战后民主交接",
        "text": "2006至2018年领导利比里亚，结束任期后向民选继任者交接权力。",
        "sourceIds": [
          "elders",
          "center"
        ]
      },
      {
        "id": "highlight-02",
        "title": "女性与和平倡议",
        "text": "与莱伊曼·古博韦、塔瓦库勒·卡曼共同获得2011年诺贝尔和平奖。",
        "sourceIds": [
          "center",
          "harvard"
        ]
      }
    ],
    "timeline": [
