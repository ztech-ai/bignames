  "role": "美国银行董事长兼首席执行官",
  "summary": "布赖恩·莫伊尼汉是美国律师及银行业管理者，2010年起任美国银行CEO，2014年起兼任董事长。他从法律及金融业务管理岗位发展至集团领导层，并自2024年起担任布朗大学治理机构负责人Chancellor。",
  "coverageNote": "核对至2026年11月17日，近期依据包括10月季度业绩及11月6日大学续任公告。总裁职务已于2025年结束；大学Chancellor与日常行政校长不同，2027年续任尚未开始。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "长期领导美国银行，推动金融危机后的风险管理和零售银行业务调整。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1981年取得布朗大学历史专业文学学士，1984年取得圣母大学法学院J.D.法律学位。"
    },
    {
      "id": "f2",
      "label": "大学治理职责",
      "value": "作为布朗大学Chancellor领导校董治理机构，参与政策与长期规划；日常行政由校长负责。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "跨业务银行管理",
      "text": "先后管理财富、企业与投资银行及消费者业务，随后领导集团；企业经营成果由管理团队与员工共同实现。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "长期治理与接班安排",
      "text": "银行于2025年设立两位联席总裁；在布朗大学，他与Pamela Ress Reeves共同主持校长遴选委员会。",
      "sourceIds": [
        "s4",
        "s6"
      ]
    }
  ],
