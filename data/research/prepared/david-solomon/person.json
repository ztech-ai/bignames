    "stars": 3,
    "scope": "field",
    "rationale": "领导高盛的投资银行与资产管理业务，参与全球资本市场和企业融资。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
