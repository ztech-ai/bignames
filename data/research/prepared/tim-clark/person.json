  "role": "阿联酋航空总裁",
  "summary": "蒂姆·克拉克是英国航空业高管，1985年加入阿联酋航空创始团队，负责航线规划，2003年起任总裁。他参与建设以迪拜为枢纽的国际网络，并曾兼任斯里兰卡航空董事总经理。其工作涉及航线、机队与客运服务战略。",
  "coverageNote": "核对至2026年11月17日。区分航空公司总裁与集团董事长兼CEO、团队建设与个人贡献、荣誉学位与所获学历；退休意向不作确定离任日期。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "参与建设阿联酋航空的国际航线网络，影响全球长途航空服务模式。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1971年获伦敦大学经济学学位；华威大学授予的法学博士为荣誉学位。"
    },
    {
      "id": "f2",
      "label": "任职边界",
      "value": "现任阿联酋航空总裁；斯里兰卡航空董事总经理任期为1998年4月至2008年3月。"
    }
  ],
