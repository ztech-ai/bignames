  "role": "蔚来创始人、董事长兼CEO",
  "summary": "李斌，英文名William Li，是中国企业家，先后参与易车等汽车互联网业务并创办蔚来。他领导团队发展电动汽车、换电和电池订阅服务，关注用户社区；产品、网络与商业模式成果涉及员工及合作伙伴。",
  "coverageNote": "核对至2026年11月17日。区分董事长与CEO任期、公司与单品牌交付、介绍上市与融资，以及已签协议和完成交割；辅助驾驶不写成无人驾驶。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "创办蔚来并参与汽车互联网业务，推动电动汽车、换电服务和用户运营模式发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "获北京大学社会学学士；2026年毕业典礼报道记其为1996届校友，不采用二手页面的法学学士说法。"
    },
    {
      "id": "f2",
      "label": "现任与历史职务",
      "value": "蔚来CEO自2018年3月起任职；易车控股董事长任期为2010至2020年，嘀嗒董事任期为2015至2025年，优信官网仍列其为董事。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "车电分离服务",
      "text": "将整车购买与电池使用订阅分开，并结合换电网络；电池资产公司由蔚来、宁德时代等合作方发起。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "h2",
      "title": "汽车互联网与用户社区",
      "text": "从汽车信息服务拓展到电动车及用户运营；社区参与不等于所有用户直接持有公司股份或拥有全部决策权。",
      "sourceIds": [
        "s1",
        "s9"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-11-01",
      "title": "公司发布10月交付报告",
      "text": "公告列10月交付34,246辆，合计蔚来、乐道与萤火虫三个品牌；该数字不是蔚来单品牌交付或季度财务业绩。",
      "sourceIds": [
        "s3"
      ]
    },
    {
      "id": "t2",
      "date": "2026-09-27",
      "title": "公布吉利充换电合作协议",
      "text": "公司宣布签订确定性协议，交易仍附监管许可等交割条件；拟定持股比例和后续投资选择权不视为已经实现。",
      "sourceIds": [
        "s7"
      ]
    },
    {
      "id": "t3",
      "date": "2022",
      "title": "香港与新加坡介绍上市",
      "text": "普通股分别于3月10日和5月20日上市；两地采用介绍方式的第二上市，不把上市本身写成新股融资。",
      "sourceIds": [
        "s5",
        "s9",
        "s10",
        "s11"
      ]
    },
    {
      "id": "t4",
      "date": "2020-08-20",
      "title": "推出电池租用服务BaaS",
      "text": "用户可购买不含电池的车辆，并订阅电池使用服务；发布时费率是历史条件，不代表当前价格。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "t5",
      "date": "2018-09-12",
      "title": "蔚来ADS在纽交所上市",
      "text": "以NIO为代码开始交易；上市及公司估值不等同于创始人的个人财富或套现。",
      "sourceIds": [
        "s5",
        "s9"
      ]
    },
    {
