  "role": "NASA局长、企业家与商业航天员",
  "summary": "贾里德·艾萨克曼是美国企业家、飞行员与商业航天员，2025年12月就任NASA第15任局长。他创办支付业务、共同创办Draken，并指挥Inspiration4与Polaris Dawn任务；航天成果来自乘组、SpaceX及科研合作团队。",
  "coverageNote": "核对至2026年11月17日。现任公共职务与已卸任企业职务分开；首创纪录保留商业或轨道限定，机构成果不全部归于个人。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与私人载人航天任务和相关技术实践，推动商业航天、科研合作及公众参与。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "航空教育",
      "value": "2011年获安柏瑞德航空大学航空学学士；2024年荣誉博士属于荣誉学位，并非研究型博士。"
    },
    {
      "id": "f2",
      "label": "企业职务交接",
      "value": "2025年6月卸任Shift4 CEO后任执行董事长，12月参议院确认NASA任命时退出董事会；Taylor Lauber接任。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "商业载人航天实践",
      "text": "指挥两次轨道任务，并与Sarah Gillis参与商业太空行走及航天服测试，保留其他乘组成员与工程团队的贡献。",
      "sourceIds": [
        "s7",
        "s8",
        "s9"
      ]
    },
    {
      "id": "h2",
      "title": "创业与公共管理",
      "text": "从支付服务与航空训练创业转入NASA管理，将企业经历带入公共机构；机构预算、审计及任务成果仍需分别评估。",
      "sourceIds": [
        "s1",
        "s3",
        "s10",
        "s11"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-11-16",
      "title": "就NASA财务审计发表声明",
      "text": "机构公告引述其现任局长声明，并报告连续第16年获得财务报表无保留审计意见；这不是个人奖项或所有项目的全面认证。",
      "sourceIds": [
        "s3"
      ]
    },
    {
      "id": "t2",
      "date": "2025-12-18",
      "title": "宣誓就任NASA局长",
      "text": "参议院于前一天确认任命；宣誓日与确认日、退出Shift4董事会的日期分开记录。",
      "sourceIds": [
        "s2",
        "s4"
      ]
    },
    {
      "id": "t3",
      "date": "2025-06",
      "title": "Shift4完成CEO交接",
      "text": "公司文件记6月4日辞去CEO、5日起任执行董事长，Lauber于5日接任CEO；董事会职务延续至12月。",
      "sourceIds": [
        "s5"
      ]
    },
    {
      "id": "t4",
      "date": "2024-09-12",
      "title": "参与首次商业太空行走",
      "text": "Polaris Dawn任务中，他与Sarah Gillis先后出舱测试SpaceX航天服；不将团队行动写成个人独立成就。",
      "sourceIds": [
        "s8",
        "s9"
      ]
    },
    {
      "id": "t5",
      "date": "2021-09-15",
      "title": "指挥Inspiration4发射任务",
      "text": "按佛罗里达当地日期，四名平民乘员升空执行轨道飞行；首次纪录限定为全平民轨道任务。",
      "sourceIds": [
        "s7"
      ]
    },
    {
      "id": "t6",
      "date": "2011",
      "title": "获得航空学学士",
      "text": "安柏瑞德大学回顾确认其学士毕业年份；专业不写成航空航天工程。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "t7",
      "date": "2011",
      "title": "共同创办Draken International",
      "text": "在佛罗里达州Lakeland发展承包式航空训练业务；与后来并入集团的英国前身历史分开。",
      "sourceIds": [
        "s1",
        "s10"
      ]
    },
    {
      "id": "t8",
      "date": "1999",
      "title": "开启支付业务创业",
      "text": "创办United Bank Card，业务后来发展为Shift4；不把早期业务起点当作后来上市控股公司的设立日期。",
      "sourceIds": [
        "s1",
        "s11"
      ]
    }
