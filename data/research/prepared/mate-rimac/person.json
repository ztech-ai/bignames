  "role": "Rimac创始人、Bugatti Rimac首席执行官",
  "summary": "马特·里马克是克罗地亚企业家与创新者，出生于利夫诺。他创办Rimac，组织团队发展高性能电动车、电池和动力系统，并领导Bugatti Rimac。整车、零部件与制造成果涉及工程团队及合作企业。",
  "coverageNote": "核对至2026年11月17日。有日期交接公告优先于无日期页面的旧职衔；区分股权交易、个人持股、展示车、客户交付与未来技术规划。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "创办Rimac，推动高性能电动汽车、电池及动力系统研发，参与欧洲汽车技术产业发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "出生与身份",
      "value": "1988年出生于今波斯尼亚和黑塞哥维那的利夫诺；克罗地亚百科全书将其列为克罗地亚创新者与企业家。"
    },
    {
      "id": "f2",
      "label": "集团与子公司职务",
      "value": "集团公告称其为集团President及Bugatti Rimac CEO；集团CEO已于2024年交给Antony Sheriff，技术公司CEO于2026年交给Nurdin Pitarević。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "整车与零部件研发",
      "text": "将电动跑车开发与电池、动力系统供应结合；车辆性能与生产成果保留团队归属。",
      "sourceIds": [
        "s3",
        "s9",
        "s10"
      ]
    },
    {
      "id": "h2",
      "title": "多品牌协作",
      "text": "在Bugatti Rimac架构下协调业务，Bugatti与Rimac仍保留不同品牌及生产基地，不把联合企业写成个人独资。",
      "sourceIds": [
        "s4",
        "s12"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-09-09",
      "title": "保时捷股权出售完成",
      "text": "保时捷与布加迪确认HOF Capital牵头财团收购相关股权；4月签约与9月完成分开，交易所得不计作里马克个人财富。",
      "sourceIds": [
        "s4",
        "s5"
      ]
    },
    {
      "id": "t2",
      "date": "2026-02-26",
      "title": "技术公司CEO交接",
      "text": "Nurdin Pitarević接任Rimac Technology CEO；里马克继续担任集团President和Bugatti Rimac CEO。",
      "sourceIds": [
        "s3"
      ]
    },
    {
      "id": "t3",
      "date": "2024-11-15",
      "title": "集团管理分工调整",
      "text": "公告任命Antony Sheriff为集团CEO，里马克转任集团管理董事会主席；该次交接与技术公司后续交接不同。",
      "sourceIds": [
        "s2"
      ]
    },
    {
      "id": "t4",
      "date": "2022-08",
      "title": "首辆客户Nevera交付",
      "text": "8月4日公告确认编号001交付Nico Rosberg；公告日不推定为实际交车日，车手的F1冠军不归于里马克。",
      "sourceIds": [
        "s11"
      ]
    },
    {
      "id": "t5",
      "date": "2022-07",
      "title": "首辆量产版本Nevera完成",
      "text": "7月12日公告记录编号000下线，但由公司保留作展示与营销车辆；尚不等于首辆客户交付。",
      "sourceIds": [
        "s10"
      ]
    },
    {
      "id": "t6",
      "date": "2021-11",
      "title": "领导Bugatti Rimac开展运营",
      "text": "11月2日公告记新公司于1日成立并运营，由里马克任CEO；不同品牌与法国、克罗地亚生产基地继续保留。",
      "sourceIds": [
        "s12"
      ]
    },
    {
      "id": "t7",
      "date": "2013",
      "title": "创办Greyp Bikes",
      "text": "克罗地亚百科全书记其创办电动自行车企业；这是历史创办事实，不推定现任职务或当前所有权。",
      "sourceIds": [
        "s1"
      ]
    },
    {
      "id": "t8",
      "date": "2009",
      "title": "创办Rimac Automobili",
      "text": "在克罗地亚发展电动跑车业务；2009年创办与后来团队扩张、车型生产及集团重组分开。",
      "sourceIds": [
        "s1",
        "s9"
      ]
    }
  ],
