  "role": "理想汽车创始人、董事长兼CEO",
  "summary": "李想是中国企业家，先后参与IT资讯、汽车互联网与新能源汽车创业，创建汽车之家网站及理想汽车。他负责企业战略与产品方向，团队推进增程式和纯电车型；公司技术与经营成果不归为个人独创。",
  "coverageNote": "核对至2026年11月17日。区分集团创办与控股公司设立、量产与交付、辅助驾驶与无人驾驶；三季报预定11月25日发布，尚不能记录为已公布。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "创办汽车之家与理想汽车，推动网络汽车服务及智能电动车产品与商业模式发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "早期经历",
      "value": "1981年出生于石家庄；高中阶段开始网站创业，后发展泡泡网与汽车之家。出生年份采用平台供稿文章，不补写未经核实的学历。"
    },
    {
      "id": "f2",
      "label": "历史董事职务",
      "value": "曾任蔚来董事（2015年5月至2018年9月）及四维图新独立董事（2017年5月至2021年12月）。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "从内容平台到汽车产品",
      "text": "从汽车消费者的信息需求延伸到车辆产品和服务，家庭用户定位见于其访谈。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "h2",
      "title": "产品与组织协作",
      "text": "作为董事长兼CEO统筹战略，车辆研发、制造及交付依赖团队；增程式与纯电路线并行。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    }
  ],
