      "id": "h1",
      "title": "制造与零售衔接",
      "text": "将商品开发、采购、制造、物流及信息系统纳入零售体系，同时使用自有与合作工厂。",
      "sourceIds": [
        "s5"
      ]
    },
    {
      "id": "h2",
      "title": "连锁家居经营",
      "text": "公司将1972年美国考察视为经营理念的重要转折，随后发展家具与家居用品的配套销售。",
      "sourceIds": [
        "s9"
      ]
    }
  ],
