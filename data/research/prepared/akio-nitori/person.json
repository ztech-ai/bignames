  "role": "宜得利创办人、Nitori Holdings董事长兼CEO",
  "summary": "似鸟昭雄是日本家居企业宜得利的创办人，担任Nitori Holdings董事长兼CEO。他从札幌家具店起步，推动商品开发、制造、物流、信息技术与零售相结合的经营模式，带领企业拓展日本及亚洲市场。",
  "coverageNote": "核对至2026年11月17日，最新财务资料发布于11月13日。区分创业、公司设立和控股架构改组；明确控股公司与零售子公司职务，业绩数据属于企业而非个人。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "创办似鸟家具，发展制造、物流与零售结合的日本家居消费模式。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1966年3月毕业于北海学园大学经济学部。"
    },
    {
      "id": "f2",
      "label": "公司与职务",
      "value": "Nitori Holdings社长兼COO为白井俊之；似鸟昭雄另任零售子公司株式会社Nitori董事长兼社长。"
    }
  ],
  "highlights": [
