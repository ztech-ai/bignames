  "role": "Flagship创始人兼CEO、Moderna共同创始人兼董事长",
  "summary": "努巴尔·阿费扬是出生于贝鲁特、具有亚美尼亚家庭背景的美加生物工程企业家。他通过Flagship组织科研与企业创建，参与Moderna等公司的发展，也共同发起Aurora人道主义倡议；科研及疫苗成果依靠团队协作。",
  "coverageNote": "核对至2026年11月17日。区分个人与公司奖项、荣誉与研究博士，以及投资承诺和实际支出；Flagship早期创办年份存在来源差异，未选定精确年份。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与创建Moderna等生命科学企业，推动平台型生物技术创业与医学创新产业化。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
