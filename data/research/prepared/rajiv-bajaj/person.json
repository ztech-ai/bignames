  "role": "Bajaj Auto董事总经理兼首席执行官",
  "summary": "拉吉夫·巴贾吉是印度汽车行业管理者，1990年开始在Bajaj Auto工作，2005年出任董事总经理。他推动以Pulsar等品牌为核心的摩托车战略和国际市场拓展；其任内公司推出电动Chetak及CNG双燃料Freedom，并取得KTM集团的间接控制权。",
  "coverageNote": "核对至2026年11月17日。区分董事总经理与董事长、Bajaj集团与汽车公司，以及产品发布、交易完成与商业效果；硕士毕业年份因官方资料冲突暂不列出。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "推动Bajaj Auto的品牌与摩托车战略，扩大印度制造业的国际市场。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "1988年获浦那大学机械工程学位，并取得华威大学制造系统工程硕士学位。"
    },
    {
      "id": "f2",
      "label": "现任职务",
      "value": "任Bajaj Auto董事总经理兼CEO；2025年开始的新任期计划至2030年3月31日，不等同董事长职务。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "以品牌推动摩托车转型",
      "text": "参与Pulsar等品牌发展，并把品牌定位与生产平台结合用于国际市场；成果来自管理、研发与制造团队共同工作。",
      "sourceIds": [
        "s3",
        "s4"
      ]
    },
    {
      "id": "h2",
      "title": "多种动力路线与跨国经营",
      "text": "其任内公司拓展电动与CNG产品，并在2025年取得KTM集团间接控制权；产品前景和重整效果仍需持续检验。",
      "sourceIds": [
        "s5",
        "s6",
        "s8"
      ]
    }
  ],
