  "role": "发展经济学家、马萨诸塞大学阿默斯特分校教授",
  "summary": "贾亚蒂·戈什是印度发展经济学家，研究全球化、就业、性别与不平等。她长期任教于尼赫鲁大学，2021年转赴马萨诸塞大学阿默斯特分校，并通过研究网络、政策咨询及公共写作参与国际经济讨论。",
  "coverageNote": "核对至2026年11月17日。区分现任与历史职务、合著与独著；ILO奖项按2011年实际颁奖记录，政策主张归于作者。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "研究全球化、就业与发展中的性别问题，参与新兴经济体公共政策讨论。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
