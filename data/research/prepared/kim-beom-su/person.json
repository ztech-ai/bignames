  "role": "Kakao创始人、未来倡议中心负责人",
  "summary": "金范洙，又名Brian Kim，是韩国互联网企业家，曾创办Hangame，后与团队发展Kakao及即时通讯服务KakaoTalk。他的工作连接游戏、通信和平台业务；产品与运营成果由团队共同实现。",
  "coverageNote": "核对至2026年11月17日。现任战略职务与历史董事长职务分开；SM案件一审无罪后进入上诉程序，未将检方求刑写成判决，亦不预判11月20日结果。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "创办Kakao，推动移动通信、数字内容和互联网服务发展，对韩国平台经济具有影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育与早期职业",
      "value": "获首尔大学工业工程学士、硕士学位，早年在三星SDS从事程序开发；2004年论坛资料列其为NHN总裁兼CEO。"
    },
    {
      "id": "f2",
      "label": "不同治理职务",
      "value": "2022年宣布退出Kakao董事会；2025年又宣布卸任企业协同委员会共同主席，保留未来倡议中心职务。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "从创业团队到移动通信",
      "text": "与合作者创办IWILAB，团队转向移动服务并推出KakaoTalk；创始人的战略作用不等于独自开发全部产品。",
      "sourceIds": [
        "s6",
        "s9"
      ]
    },
    {
      "id": "h2",
      "title": "共同慈善承诺",
      "text": "与妻子Miseon Hyeong（형미선）签署Giving Pledge，承诺生前捐出过半财产；承诺不等于已完成的捐赠金额。",
      "sourceIds": [
        "s8"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-09-23",
      "title": "SM案件上诉审结辩",
      "text": "检方请求判处15年监禁，金范洙否认违法指示并要求维持无罪。11月15日报道仍列11月20日为预定宣判日，截至核验日未写入二审结果。",
      "sourceIds": [
        "s4",
        "s10",
        "s11"
      ]
    },
    {
      "id": "t2",
      "date": "2025-10-21",
      "title": "SM案件一审无罪",
      "text": "首尔南部地方法院就股价操纵指控作出无罪判决；10月28日报道确认检方已上诉，不视为最终结案。",
      "sourceIds": [
        "s3"
      ]
    },
    {
      "id": "t3",
      "date": "2022-03-14",
      "title": "宣布退出Kakao董事会",
      "text": "公司宣布其转向海外战略并保留未来倡议中心职务；公告日与正式任职变更生效日分开。",
      "sourceIds": [
        "s1"
      ]
    },
    {
      "id": "t4",
      "date": "2021-03-16",
      "title": "签署Giving Pledge承诺书",
      "text": "与Miseon Hyeong（형미선）共同承诺生前捐出过半财产，用于社会问题；不将计划支持的创新者人数写成已完成成果。",
      "sourceIds": [
        "s8"
      ]
    },
    {
      "id": "t5",
      "date": "2014-10-01",
      "title": "Daum与Kakao合并生效",
      "text": "合并后的公司结合网络与移动业务；5月公告、10月1日生效和10月14日合并相关股份上市是不同节点。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "t6",
      "date": "2010-03",
      "title": "团队推出KakaoTalk",
      "text": "移动即时通讯服务上线；Android版本随后于8月推出，IWILAB于9月更名为Kakao。",
      "sourceIds": [
        "s6",
        "s9"
      ]
    },
    {
      "id": "t7",
      "date": "2006-12",
      "title": "创办IWILAB",
      "text": "与合作者启动后来发展为Kakao的企业；公司成立与数年后的通讯应用上线分开。",
      "sourceIds": [
        "s6",
        "s9"
      ]
    },
    {
      "id": "t8",
      "date": "1998",
      "title": "创办Hangame Communications",
      "text": "从三星SDS程序开发转向游戏创业，后参与NHN管理；创业不等同于所有后续服务同年上线。",
      "sourceIds": [
        "s12"
      ]
    }
  ],
