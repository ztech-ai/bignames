  "role": "橡树资本共同创办人、联席主席",
  "summary": "霍华德·马克斯是美国投资者与作家，1995年与伙伴共同创办橡树资本，长期从事信用与困境债务投资。他通过投资备忘录及著作讨论风险、估值和市场周期；截至核验时仍任橡树联席主席。",
  "coverageNote": "核对至2026年11月17日。出生仅确认1946年；区分2026年控股实体董事离任与橡树联席主席留任，投资观点不作为收益保证。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "共同创办橡树资本，以不良债务投资和市场周期分析影响机构投资者。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
