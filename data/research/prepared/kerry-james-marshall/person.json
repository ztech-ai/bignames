  "role": "艺术家",
  "summary": "凯里·詹姆斯·马歇尔是美国艺术家，以黑人形象为核心创作绘画，并从事雕塑等实践。他通过肖像、风景和历史画的形式讨论黑人生活及其在艺术史中的位置。出生于伯明翰、成长于洛杉矶，后在芝加哥生活和工作。",
  "coverageNote": "核对至2026年11月17日。展览记录不等于本人出席；巴黎展览的2027年结束日期仍属计划。荣誉学位与修读所得学位分别记录。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "以绘画重置黑人在艺术史和日常图像中的位置，对美国视觉文化及博物馆叙事产生重要影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "1978年获奥蒂斯艺术学院美术学士学位；1999年获该校荣誉博士学位。"
    },
    {
      "id": "f2",
      "label": "创作范围",
      "value": "以绘画著称，也创作素描、雕塑和装置；作品中的人物不都代表艺术家本人。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "黑人形象与绘画传统",
      "text": "将黑人生活置于大型绘画中心，重新思考肖像、风景及历史画的表达。",
      "sourceIds": [
