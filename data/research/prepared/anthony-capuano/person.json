  "role": "万豪国际总裁兼首席执行官",
  "summary": "安东尼·卡普阿诺是万豪国际总裁兼首席执行官，1995年加入公司，长期负责酒店开发、设计与运营服务。他于2021年出任CEO，2023年兼任总裁，工作涉及酒店业主关系、品牌扩展和集团经营。",
  "coverageNote": "核对至2026年11月17日，近期依据为11月2日季度公告。出生年份未可靠确认；区分任命生效与公告日期，不把集团所有品牌酒店都视为自有物业。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与万豪酒店开发与集团经营，推动全球酒店网络、品牌和住宿服务发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "康奈尔大学1987届校友，获酒店管理学士学位。"
    },
    {
      "id": "f2",
      "label": "业务模式",
      "value": "万豪通过特许经营、管理和许可等方式经营住宿品牌；品牌网络规模不等于自有酒店数量。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "全球酒店开发",
      "text": "从市场规划与可行性研究起步，逐步承担全球开发、设计和运营职责，协调业主、开发商及运营方需求。",
      "sourceIds": [
        "s1",
