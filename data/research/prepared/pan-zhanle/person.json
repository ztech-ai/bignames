  "role": "游泳运动员",
  "summary": "潘展乐是中国自由泳运动员，在2024年巴黎奥运会男子100米自由泳决赛中以46秒40夺冠并创造长池世界纪录。他还与队友夺得男子4×100米混合泳接力金牌。其履历包括奥运会、世锦赛、亚运会及国内赛事的单项和接力成绩。",
  "coverageNote": "核对至2026年11月17日。区分50米长池、25米短池、接力首棒和后续棒次；团队成绩不归为个人单项纪录。未来参赛计划不作已完成比赛。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "奥运冠军与自由泳世界纪录创造者，对亚洲短距离游泳形成重要突破。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "巴黎奥运奖牌",
      "value": "2024年获得两金一银：男子100米自由泳、男子4×100米混合泳接力金牌，以及男女混合4×100米混合泳接力银牌。"
    },
    {
      "id": "f2",
      "label": "成绩口径",
      "value": "46秒40是50米池单项世界纪录；巴黎接力末棒45秒92为接力分段，2026年全国赛46秒20为25米池成绩。"
    }
  ],
