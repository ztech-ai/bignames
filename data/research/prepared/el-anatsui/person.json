  "role": "雕塑家与装置艺术家",
  "summary": "埃尔·阿纳祖是加纳艺术家，长期在尼日利亚任教和创作，以铝制酒瓶盖、铜线等材料构成可随展示改变形态的金属雕塑。他的实践也涵盖陶、木和版画，将材料再利用与贸易、殖民历史及消费联系起来。作品由他构思，并与工作室团队协作制作。",
  "coverageNote": "核对至2026年11月17日。区分加纳身份与尼日利亚工作经历、艺术委托与奖项、作品制作与入藏年份。未来展览按公告记录，不把作品展出或交易视为本人到场证明。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "以回收金属和可变形装置连接非洲工艺、贸易史与全球消费，推动材料艺术的国际影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "学历与教学",
      "value": "履历列1968年完成KNUST学士阶段、1969年获艺术教育研究生文凭；1975年到尼日利亚大学任教，教授职务列为1996至2011年。"
    },
    {
      "id": "f2",
      "label": "形式与材料",
      "value": "将折叠、压平的铝制瓶盖以铜线连接；外观类似织物，但属于金属雕塑，安装时可重新塑形。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "材料承载的历史",
      "text": "通过回收物追问消费、贸易和殖民交流；创作不只限于瓶盖，也包括陶、木、印版和版画。",
      "sourceIds": [
        "s1",
        "s3",
        "s6"
      ]
    },
    {
      "id": "h2",
      "title": "协作与非固定形态",
      "text": "助手制作连接单元，艺术家发展构图，安装进一步改变作品；保留工作室团队的劳动与作品可变性。",
      "sourceIds": [
        "s9",
        "s11"
      ]
    }
  ],
