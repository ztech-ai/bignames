  "role": "福特汽车总裁兼CEO",
  "summary": "吉姆·法利是美国汽车业高管，曾在丰田及雷克萨斯任职，2007年加入福特。2020年出任总裁兼CEO，推动商用车、软件服务和电动车业务调整。其职业轨迹涵盖品牌营销、区域经营与集团管理。",
  "coverageNote": "核对至2026年11月17日。区分任命公告与生效、董事与CEO、荣誉学位与修读学历；企业转型目标不视为已完成成果。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "领导福特的汽车业务调整，推进商用车、软件服务与电动产品发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "乔治敦大学1985届经济学本科毕业生，后获UCLA安德森管理学院管理学位；2026年获乔治敦荣誉人文学博士。"
    },
    {
      "id": "f2",
      "label": "跨公司职务",
      "value": "担任福特总裁兼CEO及董事，并于2026年加入麦当劳董事会；后者不是经营管理职务。"
    }
  ],
  "highlights": [
