  "role": "宾堡集团执行董事长、前CEO",
  "summary": "丹尼尔·塞尔维特赫是墨西哥企业家，长期领导宾堡集团的烘焙业务与跨国扩展。1997年出任CEO，2013年兼任董事长，2024年转为执行董事长，继续负责战略；他是共同创办人Lorenzo Servitje之子，并非集团创办人。",
  "coverageNote": "核对至2026年11月17日，近期个人活动依据为IPADE于10月20日发表的对谈报道。执行董事长与CEO分开；2024年接任CEO的Pamias已非2026年的现任CEO。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "领导宾堡集团扩展全球烘焙业务，推动食品生产与跨国供应链整合。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1982年获伊比利亚美洲大学工商管理学士，1987年获斯坦福大学MBA；两所院校及年份分别记录。"
    },
    {
      "id": "f2",
      "label": "现任经营管理分工",
      "value": "塞尔维特赫担任执行董事长；公司2026年资料列Alejandro Rodríguez Bas为CEO，任命于2025年11月。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "跨国食品业务",
      "text": "通过集团并购及分销网络扩展烘焙业务；Canada Bread收购属于公司交易，不把集团资产或集体经营成果等同个人财产与单独贡献。",
      "sourceIds": [
        "s5",
        "s3"
      ]
    },
    {
      "id": "h2",
      "title": "长期治理与转型",
      "text": "2026年对谈强调贴近一线经营、人才和技术学习。这些是他的管理观点，不代表AI工具效果或企业社会表现已获独立认证。",
      "sourceIds": [
        "s4"
      ]
    }
  ],
  "timeline": [
