        "s5"
      ]
    },
    {
      "id": "t5",
      "date": "2013-07-01",
      "title": "出任集团董事长",
      "text": "在既有CEO职责之外担任董事长；不是2024年新设执行董事长职位的起点。",
      "sourceIds": [
        "s6",
        "s7"
      ]
    },
    {
      "id": "t6",
      "date": "1997",
      "title": "出任宾堡CEO",
      "text": "开始领导集团日常经营；采用公司公告及星巴克履历，不沿用二手资料的2007年起始说法。",
