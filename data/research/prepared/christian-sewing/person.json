  "role": "德意志银行首席执行官、管理董事会主席",
  "summary": "克里斯蒂安·泽温是德国银行家，1989年加入德意志银行，经历信贷、风险与审计岗位后于2018年出任CEO。他主持业务重组；评价其任期也需考虑人员缩减、合规问题及整改责任。",
  "coverageNote": "核对至2026年11月17日，包括当日银行对媒体报道的回应。区分管理董事会与监事会、企业声明与独立结论，以及已报告业绩与未来目标。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "领导德意志银行的重组，调整投资银行规模并加强企业与零售金融。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "职业教育",
      "value": "接受银行学徒培训，后取得Bankakademie比勒费尔德及汉堡的文凭；不改写为未经核实的大学学位或MBA。"
    },
    {
      "id": "f2",
      "label": "治理架构",
      "value": "CEO兼管理董事会主席属于执行管理层，并非监事会主席；CEO任命由监事会决定。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "重组与就业影响",
      "text": "2019年方案收缩股票销售交易业务并设立企业银行部门，同时计划到2022年减少约1.8万个全职当量岗位；计划不等于当时已经完成的裁员。",
      "sourceIds": [
        "s3"
      ]
    },
    {
      "id": "h2",
      "title": "合规评价的边界",
      "text": "2026年11月银行回应调查报道，强调历史问题和内控投入。公司说法不能作为独立免责结论，报道本身也不等于泽温个人违法的司法认定。",
      "sourceIds": [
        "s6"
      ]
    }
  ],
  "timeline": [
