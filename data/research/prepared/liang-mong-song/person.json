  "role": "半导体工程师、中芯国际联合CEO",
  "summary": "梁孟松是台湾出生的半导体工程师，曾在台积电和三星工作，2017年加入中芯国际任联合CEO。他的职业重点是存储器、先进逻辑工艺研发与技术团队管理，工艺成果涉及研发、制造和供应链的共同工作。",
  "coverageNote": "核对至2026年11月17日。执行董事辞任与联合CEO任职分开；量产、研发和节点名称不混用。司法事项采用历史裁判限制的准确范围，不将民事限制写成刑事定罪。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与先进半导体制造工艺研发和技术管理，对晶圆制造技术与亚洲芯片产业具有影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "博士研究",
      "value": "1984年获加州大学伯克利分校博士，导师胡正明；论文研究薄栅氧化层MOSFET在电流与电场应力下的退化。"
    },
    {
      "id": "f2",
      "label": "现职与历史董事职务",
      "value": "2026年半年报仍列其为联合CEO；执行董事任期为2017年10月16日至2021年11月11日，辞任董事未结束联合CEO职务。"
    }
  ],
