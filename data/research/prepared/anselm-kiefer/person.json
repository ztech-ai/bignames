  "role": "画家、雕塑家与装置艺术家",
  "summary": "安塞尔姆·基弗是长期在法国工作的德国艺术家，以绘画、雕塑、艺术家书籍和大型装置探讨德国历史、大屠杀记忆、诗歌与神话。他使用铅、稻草等材料，把图像、文字和物质变化结合起来；其对纳粹符号的早期运用旨在追问被压抑的历史，也曾引发解释上的争议。",
  "coverageNote": "核对至2026年11月17日。保留作品的批判性历史语境，不把对纳粹符号的再现写成政治认同；区分创作、展出、扩充与未来展期，展览举办不等同于艺术家本人到场。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "以大型绘画和装置处理战争记忆、神话与材料，推动当代艺术对德国历史及文化责任的讨论。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "艺术训练",
      "value": "先学习法律和罗曼语文学，后在弗赖堡和卡尔斯鲁厄接受艺术训练，师从彼得·德雷尔、霍斯特·安特斯；与博伊斯交往不直接写成取得其正式学位。"
    },
    {
      "id": "f2",
      "label": "诗歌与材料",
      "value": "1981年《你的金发，玛格丽特》馆藏版本以丙烯、乳剂、木炭和稻草在粗麻布上创作，联系保罗·策兰的《死亡赋格》。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "历史记忆与自我质询",
      "text": "通过德国文化、战争遗迹和文学意象追问战后身份与历史责任；作品的意义和接受史保留争议与复杂性。",
      "sourceIds": [
        "s1",
        "s2",
        "s6"
      ]
    },
    {
      "id": "h2",
      "title": "从画面延伸到空间",
      "text": "将铅书、混凝土、植物和建筑结构纳入创作，使绘画、雕塑及工作室场域相互联系。",
      "sourceIds": [
        "s1",
        "s4",
        "s5"
      ]
    }
  ],
