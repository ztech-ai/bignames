  "role": "星巴克董事长兼首席执行官",
  "summary": "布赖恩·尼科尔是美国餐饮与消费品牌管理者，2024年9月起担任星巴克董事长兼CEO。他此前领导Taco Bell及Chipotle，职业经历涵盖品牌营销、门店经营与数字订单服务，并在星巴克推动回归咖啡馆体验的经营调整。",
  "coverageNote": "核对至2026年11月17日，近期依据为10月29日业绩公告。区分董事长与CEO任期、公告与生效日期，以及同店销售和总收入；经营计划不等同已实现成果。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "先后领导Chipotle与星巴克，推动连锁餐饮品牌、门店经营和数字订单。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1996年获俄亥俄州迈阿密大学工程管理学士，2003年获芝加哥大学布斯商学院MBA。"
    },
    {
      "id": "f2",
      "label": "董事会经历",
      "value": "担任沃尔玛董事，曾任KB Home与哈雷戴维森董事；董事身份不同于公司的日常经营负责人。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "品牌与数字服务经验",
      "text": "在必胜客、Taco Bell与Chipotle积累菜单、品牌及数字服务管理经验；相关产品及运营由团队共同推进。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "重建咖啡馆体验",
      "text": "提出Back to Starbucks计划，强调咖啡、咖啡师与顾客联系，同时承认部分门店存在等待过长和体验不一致的问题。",
      "sourceIds": [
        "s7"
      ]
    }
  ],
  "timeline": [
