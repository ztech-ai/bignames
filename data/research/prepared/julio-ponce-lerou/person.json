  "role": "智利企业家、SQM前董事长",
  "summary": "胡里奥·庞塞·莱鲁是智利林业工程师和企业家，曾在皮诺切特统治时期担任公共部门职务，后来长期领导SQM董事会。他通过多层控股公司参与矿业投资，其经历涉及私有化、家族企业传承及Cascadas证券交易争议。",
  "coverageNote": "核对至2026年11月17日。区分董事职务与股权、重组宣布与完成、行政罚款与民事索赔；不把特定索赔被驳回写成所有案件无罪。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "长期参与SQM治理与智利锂产业，影响全球电池原材料供应和企业治理讨论。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "智利大学林业工程师；不推定具体毕业年份或额外学位。"
    },
    {
      "id": "f2",
      "label": "职务与家族传承",
      "value": "2015年退出SQM董事会，2025年宣布将后续管理与家族资产事务交由以女儿Francisca为代表的家族承接。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "矿业与控股结构",
      "text": "长期通过控股公司参与SQM；公司业务包括锂、碘和硝酸盐，不能将公司产出全部归于个人。",
      "sourceIds": [
        "s3",
        "s7"
      ]
    },
    {
      "id": "h2",
      "title": "证券监管与民事诉讼",
      "text": "Cascadas案涉及行政罚款及另行提出的民事索赔；罚款减额与索赔被驳回属于不同程序。",
      "sourceIds": [
        "s4",
        "s5"
      ]
    }
  ],
  "timeline": [
