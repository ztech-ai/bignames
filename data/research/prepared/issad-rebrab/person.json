  "role": "Cevital创办人、前集团负责人",
  "summary": "伊萨德·雷布拉布是阿尔及利亚企业家，由会计业务转向金属工业，并于1998年创办Cevital集团，拓展食品加工及欧洲制造业投资。2022年将集团领导职务交给儿子Malik；其事业也涉及刑事判决及后续经营限制。",
  "coverageNote": "核对至2026年11月17日。出生仅确认1944年；现职、判决、获释和经营限制分别记录，近期身份依据二手报道。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "创办Cevital工业集团，发展阿尔及利亚食品加工、制造与国际投资。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "早期经历",
      "value": "曾学习会计并从事教学，1968年开设会计事务所；不据此推断具体大学学位。"
    },
    {
      "id": "f2",
      "label": "领导权交接",
      "value": "2022年6月宣布于30日退休，由儿子Malik接任；旧公司简介的现任董事长表述已过时。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "工业与国际投资",
      "text": "从金属业务扩展至食品加工，并通过Oxxo、Brandt等交易参与欧洲制造业。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "司法记录与限制",
      "text": "2020年获判18个月，其中12个月缓刑，随后获释；2023年被报道受到经营限制，两者不是同一裁决。",
      "sourceIds": [
        "s4",
        "s5",
        "s6"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2023-05",
      "title": "经营限制被报道",
      "text": "媒体援引5月23日文件，称其被禁止从事商业与企业管理；不将限制写作新的刑事定罪。",
      "sourceIds": [
        "s6",
        "s7"
      ]
    },
    {
      "id": "t2",
      "date": "2022-06-30",
      "title": "集团领导职务交接",
      "text": "按6月22日公布的安排退休，Malik接任；后续报道确认当年6月交接。",
      "sourceIds": [
        "s3",
        "s7"
      ]
    },
    {
      "id": "t3",
      "date": "2020-01-01",
      "title": "判刑后获释",
      "text": "报道记载18个月刑期含6个月实刑、12个月缓刑；此前羁押时间已超过实刑部分，获释不等于无罪。",
      "sourceIds": [
        "s4",
        "s5"
      ]
    },
    {
      "id": "t4",
      "date": "2014",
      "title": "收购Brandt法国业务",
      "text": "Cevital在法国扩展家电制造业务；记录当年的收购，不推断资产持续归属。",
      "sourceIds": [
        "s1"
      ]
    },
    {
      "id": "t5",
      "date": "2013",
      "title": "收购Oxxo",
