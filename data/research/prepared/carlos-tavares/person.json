  "role": "葡萄牙汽车业经理人、Stellantis前首席执行官",
  "summary": "卡洛斯·塔瓦雷斯曾在雷诺、日产及PSA担任管理职务，参与欧洲汽车业整合，并出任Stellantis首任CEO。他于2024年12月1日辞职；其经营经历既包括企业重组，也包括与董事会出现分歧后的离任。",
  "coverageNote": "核对至2026年11月17日，在世依据为8月17日刊发的采访。保留前任职衔，区分并购完成、治理生效与继任日期；对行业政策的评论明确归为本人观点。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "领导标致雪铁龙复兴并参与组建Stellantis，影响欧洲汽车业整合。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1981年毕业于巴黎中央理工学院，接受工程教育。"
    },
    {
      "id": "f2",
      "label": "领导职务交接",
      "value": "2024年12月离任后由John Elkann领导临时执行委员会；Antonio Filosa于2025年6月23日接任CEO。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "跨企业整合经验",
      "text": "从PSA收购欧宝及沃克斯豪尔，到PSA与FCA合并组建Stellantis，他参与多品牌整合；交易及经营成果属于各方共同工作。",
