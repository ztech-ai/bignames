  "role": "香港交易所集团行政总裁",
  "summary": "陈翊庭是香港金融业管理者及律师，自2024年3月起担任香港交易所集团行政总裁。她曾负责首次公开招股审核和上市业务，并任联席营运总监；此前在投资银行与国际律师事务所从事资本市场工作。",
  "coverageNote": "核对至2026年11月17日，近期依据为11月6日业绩公告。出生年份存在资料差异，保留未知；区分任命生效、公告日期与未来续任，以及公司成果与个人贡献。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "在香港交易所推动上市监管和资本市场发展，参与国际金融中心建设。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1991年毕业于香港大学法律系，1993年毕业于哈佛法学院，分别取得法学学士与法学硕士学位。"
    },
    {
      "id": "f2",
      "label": "专业资格",
      "value": "具香港律师及美国纽约州律师资格；法学硕士不写作博士或MBA。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "法律与上市业务经验",
      "text": "在私人执业、投行法律部门与交易所之间积累经验，参与上市审核、制度及运营管理。",
      "sourceIds": [
        "s1",
        "s6",
        "s8"
      ]
    },
    {
      "id": "h2",
      "title": "多元资产市场发展",
      "text": "作为集团行政总裁推动产品及市场基础设施建设；相关改革由交易所团队、监管机构及市场参与者共同推进。",
      "sourceIds": [
        "s4",
        "s9"
      ]
    }
  ],
