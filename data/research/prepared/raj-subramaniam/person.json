  "role": "联邦快递集团总裁兼首席执行官",
  "summary": "拉杰·苏布拉马尼亚姆1991年加入联邦快递，历任营销和运营管理职务，2022年接任集团CEO。他领导下的集团推进快递业务整合，并于2026年完成货运业务分拆和供应链子公司出售；业务重组的长期效果仍需观察。",
  "coverageNote": "核对至2026年11月17日。出生日期因来源冲突暂缺；区分集团与运营公司、合并与网络整合、货运分拆与供应链出售，不把预测当作实绩。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "领导联邦快递并推进运营整合，参与国际物流与供应链服务发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "印度理工学院化学工程学士、雪城大学化学工程硕士及得克萨斯大学奥斯汀分校MBA。"
    },
    {
      "id": "f2",
      "label": "职务边界",
      "value": "2019年3月出任集团总裁兼COO，2022年6月1日接任CEO；董事身份不等同董事长。"
    }
  ],
