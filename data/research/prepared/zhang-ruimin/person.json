  "role": "海尔创始人、集团董事局名誉主席",
  "summary": "张瑞敏是中国企业管理者，1984年接任青岛电冰箱总厂厂长，长期领导海尔的质量改进、国际化与组织变革。他提出人单合一模式，探索员工自主经营与用户价值的联系。2021年交棒后担任名誉主席，继续参与管理思想讨论。",
  "coverageNote": "核对至2026年11月17日。区分厂长、董事长、CEO与名誉主席，以及海尔集团与上市公司。管理模式、奖项和案例研究不等同于其普遍成效已得到独立证明。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "推动海尔从家电工厂发展为国际企业，并探索组织管理与员工创业机制。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
