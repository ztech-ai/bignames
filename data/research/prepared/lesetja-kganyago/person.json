  "role": "南非储备银行行长、斯泰伦博斯大学校监",
  "summary": "列索·卡尼亚戈是南非经济学家和中央银行管理者，曾任财政部总司长与南非储备银行副行长，2014年起担任行长。他参与货币政策、金融稳定和国际金融治理，也担任斯泰伦博斯大学的礼仪性校监。其公开政策论述强调价格稳定、制度公信力与结构性改革的不同作用。",
  "coverageNote": "核对至2026年11月17日。区分现职与旧职、任命公告与生效日期、通胀目标与实际结果，以及支付改革计划与已完成措施。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "领导南非储备银行，参与新兴市场货币政策与国际金融治理。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "拥有南非大学会计与经济学商科学士、伦敦大学亚非学院发展经济学理学硕士学位；荣誉博士另行区分。"
    },
    {
      "id": "f2",
      "label": "行长任期",
      "value": "第三个五年任期于2024年11月9日开始，预定2029年11月8日结束；后者不是已经完成的任期。"
    }
  ],
  "highlights": [
