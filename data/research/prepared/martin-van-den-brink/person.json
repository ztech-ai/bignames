  "role": "ASML前总裁兼CTO、董事会顾问",
  "summary": "马丁·范登布林克是荷兰工程师与技术管理者，1984年加入ASML，长期参与光刻系统、浸没式与极紫外技术发展。2024年卸任总裁兼CTO后继续担任顾问；其贡献依赖跨学科团队及产业协作。",
  "coverageNote": "核对至2026年11月17日。区分ASML与ASM、现任顾问与已卸任职务、奖项公告与授予；11月27日计划举行的荣誉博士仪式尚未发生。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "推动ASML光刻系统工程与极紫外技术研发，参与先进芯片制造关键设备的技术演进。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "工程教育",
      "value": "接受HTS Arnhem电气工程教育，1980年进入特温特大学应用物理专业，1984年毕业；毕业项目涉及区域供热。"
    },
    {
      "id": "f2",
      "label": "技术管理",
      "value": "1995年出任ASML技术副总裁，1999年加入管理董事会，2013年出任总裁兼CTO。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "光刻系统发展",
      "text": "参与对准、TWINSCAN双工作台、浸没式及EUV光刻技术发展，不将完整系统视为个人独立发明。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "跨学科工程方法",
      "text": "在大学访谈中强调连接系统层面与专业细节，协调光学、机电、软件及物理等领域。",
      "sourceIds": [
        "s5"
      ]
    }
  ],
