  "role": "S4Capital创办人兼执行董事长；WPP前CEO",
  "summary": "马丁·索雷尔是英国广告业企业家，通过并购和业务整合推动WPP发展为跨国营销服务集团。2018年离开WPP后，他创办S4Capital，转向数字广告、数据与技术服务。其职业经历连接了传统广告集团扩张与数字营销转型。",
  "coverageNote": "核对至2026年11月17日。区分1985年投资与1986年CEO任职、S4Capital创办与上市公司董事任命，以及离职指控和已裁定事实。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "发展WPP并创办S4 Capital，推动全球广告、营销服务和数字传播业务。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "在剑桥大学基督学院学习经济学，1968年取得哈佛商学院MBA；2017年起为基督学院荣誉院士。"
    },
    {
      "id": "f2",
      "label": "现职",
      "value": "S4Capital创办人兼执行董事长；公司以Monks品牌运营，WPP CEO为其既往职务。"
    }
  ],
  "highlights": [
