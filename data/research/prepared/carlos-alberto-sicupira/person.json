  "role": "巴西投资者、3G Capital创始合伙人之一",
  "summary": "卡洛斯·阿尔韦托·西库皮拉是巴西投资者，长期与Jorge Paulo Lemann、Marcel Telles合作，参与零售、啤酒及消费企业投资，也是3G Capital创始合伙人之一。他曾领导Americanas，2024年退出该公司董事会；围绕其在会计丑闻中的知情情况，调查与辩护仍需分别呈现。",
  "coverageNote": "核对至2026年11月17日，近期依据为11月9日律师声明及公司治理名单。区分董事会与委员会、集团与个人投资；调查不等于定罪，财产保全暂停也不等于无罪判决。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与巴西零售、消费品与3G投资，影响企业收购和经营管理实践。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
