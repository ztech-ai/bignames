  "role": "本田汽车社长兼首席执行官",
  "summary": "三部敏宏从汽车动力系统研发走向本田集团经营管理，2021年出任社长兼CEO。其任内本田推进电动化，也在市场变化和经营压力下调整战略，包括2026年取消三款原计划在北美生产的电动车开发与上市。",
  "coverageNote": "核对至2026年11月17日。区分本田技术研究所与本田汽车、任命公告与履职、公司战略与个人成就，以及整合谈判和已完成交易；改革目标不视作已实现成果。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "在本田负责研发及集团经营，推动汽车电动化与动力系统战略调整。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1987年完成广岛大学工学研究科硕士课程，同年4月加入本田。"
    },
    {
      "id": "f2",
      "label": "研发经历",
      "value": "长期从事汽车与动力系统研发，2019年4月出任本田技术研究所社长。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "从研发走向集团经营",
      "text": "曾领导本田技术研究所，2021年接替八乡隆弘执掌本田汽车。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "h2",
      "title": "电动化战略调整",
      "text": "本田于2026年宣布取消三款北美计划车型并调整财务预期，不等于停止所有电动车项目。",
      "sourceIds": [
        "s6"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-10-09",
      "title": "经营改革座谈随报告发布",
      "text": "综合报告收录其与其他高管讨论组织及经营改革的座谈；此日为报告发布日期。",
      "sourceIds": [
        "s7",
        "s8"
      ]
    },
    {
      "id": "t2",
      "date": "2026-03-12",
      "title": "本田调整电动化计划",
      "text": "公司宣布取消Honda 0 SUV、Honda 0 Saloon和Acura RSX三款北美计划车型，预计产生损失并修订业绩预测。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "t3",
      "date": "2025-02-13",
      "title": "终止日产经营整合谈判",
      "text": "两家公司终止整合备忘录及相关讨论，仍保留战略合作框架；没有完成合并。",
      "sourceIds": [
        "s5"
      ]
    },
    {
      "id": "t4",
      "date": "2021-06",
      "title": "治理体制变化后的职衔",
      "text": "官方履历记录其成为董事、社长及代表执行官，区别于4月开始担任社长。",
      "sourceIds": [
        "s1"
      ]
    },
    {
      "id": "t5",
      "date": "2021-04-01",
      "title": "就任本田社长兼CEO",
      "text": "接替八乡隆弘；继任安排于同年2月19日公布。",
      "sourceIds": [
        "s1",
        "s2"
      ]
    },
    {
      "id": "t6",
      "date": "2019-04",
      "title": "领导本田技术研究所",
