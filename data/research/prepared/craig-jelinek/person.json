  "role": "Costco前首席执行官",
  "summary": "克雷格·杰利内克是美国零售业管理者，从仓储门店运营走向Costco最高管理岗位，2012年起担任CEO，2024年1月交棒Ron Vachris。他延续会员制低价零售模式，并在公开证词中强调员工薪酬与留任；不是Costco创办人。",
  "coverageNote": "核对至2026年11月17日，近期个人活动依据为3月12日母校对其创业辅导的报道。区分CEO、总裁、雇员与董事任期；历史工资公告不作为当前薪酬标准。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "长期领导好市多，推动会员制仓储零售的规模扩张与运营文化。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "圣迭戈州立大学1975届工商管理校友；不依据二手概述推定取得两个独立学位。"
    },
    {
      "id": "f2",
      "label": "总裁与CEO任期",
      "value": "2012年1月至2022年2月兼任总裁与CEO，此后继续任CEO至2023年末；总裁职务此前已交给Vachris。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "会员制经营",
      "text": "以有限商品选择、大销量及简洁门店控制成本，为会员提供低价；这延续了公司既有模式，不是个人独创。",
      "sourceIds": [
        "s6",
        "s3"
      ]
    },
    {
      "id": "h2",
      "title": "员工与经营",
      "text": "2021年参议院证词将工资、福利和员工留任联系起来；相关说法体现公司的经营立场，不能等同全部劳动条件的独立评价。",
      "sourceIds": [
        "s6"
      ]
    }
  ],
