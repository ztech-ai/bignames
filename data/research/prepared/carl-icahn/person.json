  "role": "投资者、伊坎企业普通合伙人董事长",
  "summary": "卡尔·伊坎是美国投资者，以持股推动公司治理、资本配置和重组而知名。他于1968年创办Icahn & Co.，后来通过伊坎企业及关联机构投资多个行业。他的股东行动引发对短期收益与企业长期发展的讨论，也支持教育和医学研究。",
  "coverageNote": "核对至2026年11月17日。区分普通合伙人董事长与公司CEO、未来接班计划与已完成任命、公司业绩与个人财富。2024年SEC和解保留罚款主体和不承认也不否认调查结论的条件。",
  "influence": {
    "stars": 4,
    "scope": "field",
    "rationale": "长期从事股东行动和企业收购，影响美国上市公司的治理与资产重组。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1957年毕业于普林斯顿大学哲学专业，随后曾在纽约大学医学院就读；未将就读写成医学学位。"
    },
    {
      "id": "f2",
      "label": "治理角色",
      "value": "自1990年起任伊坎企业普通合伙人董事长；2026年公司CEO另有其人，布雷特·伊坎接班仍属计划。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "以持股推动变化",
      "text": "通过重要持股和与管理层交涉推动治理及资本配置调整；这些行动的收益和长期影响存在争论。",
      "sourceIds": [
        "s1",
        "s10"
      ]
    },
    {
      "id": "h2",
      "title": "教育与医学资助",
      "text": "家族基金会资助普林斯顿基因组学实验室；西奈山医学院以其名更名，体现长期捐赠支持。",
      "sourceIds": [
        "s3",
        "s4"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-11-03",
      "title": "伊坎企业公布第三季度业绩",
      "text": "公司报告归属于IEP的季度净亏损2.25亿美元；这是公司业绩，不等同于伊坎个人财富变化。",
      "sourceIds": [
        "s9"
      ]
    },
    {
      "id": "t2",
      "date": "2026-05-06",
      "title": "公司任命新CEO",
      "text": "Ted Papapostolou升任总裁兼CEO；该任命不表示伊坎卸任普通合伙人董事长。",
      "sourceIds": [
        "s6",
        "s7",
        "s8"
      ]
    },
    {
      "id": "t3",
      "date": "2024-08-19",
      "title": "就证券质押披露与SEC和解",
      "text": "伊坎与IEP分别同意支付50万及150万美元民事罚款，且不承认也不否认调查结论。",
      "sourceIds": [
        "s5"
      ]
    },
    {
      "id": "t4",
      "date": "2012-11-15",
      "title": "西奈山公布医学院更名",
      "text": "校方公告以伊坎之名更名，并说明累计捐赠接近2亿美元；不是单次新增2亿美元。",
      "sourceIds": [
        "s4"
      ]
    },
    {
      "id": "t5",
      "date": "1999-12-10",
      "title": "基金会资助基因组学实验室",
      "text": "普林斯顿宣布伊坎家族基金会捐赠2000万美元用于实验室建设。",
      "sourceIds": [
        "s3"
      ]
    },
    {
