  "role": "汇丰集团行政总裁",
  "summary": "乔治·埃尔赫德里又名艾桥智，是出生于黎巴嫩的法国银行业管理者。2005年加入汇丰，历任区域、金融市场及集团财务领导职务，2024年出任集团行政总裁，推动业务架构精简及跨境银行、财富管理业务发展。",
  "coverageNote": "核对至2026年11月17日。出生年仅见约1974年，未填入确定日期；公司业绩、奖项评价和未来计划分别记录。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "在汇丰承担金融市场和集团领导职责，参与跨境银行业务与组织调整。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "获法国综合理工学院工程学位及ENSAE统计学与经济学研究生学位。"
    },
    {
      "id": "f2",
      "label": "金融市场经历",
      "value": "曾任汇丰环球银行及资本市场联席主管，2023年转任集团财务总监。"
    }
  ],
  "highlights": [
    {
