  "role": "MySQL共同创始人、MariaDB公司CTO",
  "summary": "迈克尔·维德纽斯是芬兰程序员，以Monty之名活跃于数据库社区。他参与创建MySQL，推动MariaDB分支及其社区发展，并参与建立MariaDB基金会。其技术与组织工作由众多开发者共同推进。",
  "coverageNote": "核对至2026年11月17日。区分MariaDB公司与基金会、项目开始与首个版本发布，以及收购公告与完成；早期MySQL年份存在来源差异，未写入精确年表。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "共同创建MySQL并推动MariaDB发展，对开放数据库软件和互联网应用基础设施具有影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育与技术写作",
      "value": "曾就读赫尔辛基理工大学，并合著MySQL参考手册；就读经历不表述为取得学位。"
    },
    {
      "id": "f2",
      "label": "组织职务",
      "value": "担任MariaDB公司CTO，并以创始人身份担任MariaDB基金会当然董事；基金会CEO为Anna Widenius。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "开放数据库基础设施",
      "text": "参与MySQL与MariaDB开发，为互联网应用提供关系数据库工具；不将团队全部成果归于个人。",
      "sourceIds": [
        "s1",
        "s8"
      ]
    },
    {
      "id": "h2",
      "title": "社区治理",
      "text": "参与建立独立基金会，为数据库代码、贡献者及用户社区提供持续协作机制。",
      "sourceIds": [
        "s2",
        "s6"
      ]
    }
  ],
