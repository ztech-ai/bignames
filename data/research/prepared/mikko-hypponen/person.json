  "role": "Sensofusion首席研究官、网络安全作者",
  "summary": "米科·许波宁是芬兰安全研究者，长期从事恶意软件分析，并通过演讲和写作讨论网络犯罪、隐私与联网设备风险。2025年从WithSecure转向Sensofusion，将威胁研究经验用于无人机防护领域。",
  "coverageNote": "核对至2026年11月17日。转职公告与计划入职时间分开；任职34年不等于全程担任首席研究官，AI预测与产品性能说法不作为独立验证结论。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "长期研究恶意软件与网络犯罪，通过技术工作和公共演讲推动信息安全意识传播。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
