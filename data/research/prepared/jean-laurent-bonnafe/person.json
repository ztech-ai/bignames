  "role": "法国巴黎银行董事兼CEO",
  "summary": "让-洛朗·博纳费是法国银行业高管，工程教育及公共部门经历之后于1993年加入BNP，参与集团整合并管理零售银行业务。2011年出任法国巴黎银行CEO，任内经历业务出售与资管扩张，也负责回应银行的重大合规事件。",
  "coverageNote": "核对至2026年11月17日。区分集团与子公司职位、董事与董事长、交易公告与交割；银行法律责任不等同于个人定罪。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "长期领导法国巴黎银行，参与欧洲银行业与全球企业融资的发展。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育与早期经历",
      "value": "毕业于法国综合理工学院和矿业学校，接受工程教育，早期曾在法国公共部门任职。"
    },
    {
      "id": "f2",
      "label": "治理角色",
      "value": "担任法国巴黎银行董事兼CEO；董事长为Jean Lemierre，两者职责不同。"
    }
  ],
