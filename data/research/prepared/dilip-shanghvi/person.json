  "role": "太阳制药创始人兼执行董事长",
  "summary": "迪利普·尚哈维是印度企业家，1983年创办太阳制药，推动其从精神科药品业务拓展为跨国制药企业。其工作涉及企业战略、并购与研发投入；2025年交出董事总经理职务后继续担任执行董事长。",
  "coverageNote": "核对至2026年11月17日，近期依据为10月30日业绩电话会文字稿。Organon收购当时仍待交割，预计2027年初完成属于前瞻判断。出生日期来源冲突，保留1955年10月精度。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "创办太阳制药，通过药物研发和并购发展印度仿制药及专科药业务。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "获加尔各答大学商学学士；公司履历中的Managing Director为管理职务，不能解读为医学学位。"
    },
    {
      "id": "f2",
      "label": "角色分工",
      "value": "现任执行董事长，Kirti Ganorkar任董事总经理；尚哈维仍参与战略及研发讨论，并非全面退休。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "研发投入",
      "text": "2026年10月电话会中，他报告季度研发投入77.84亿印度卢比，占销售额4.8%；支出与研发管线不等同临床成功或药品获批。",
      "sourceIds": [
        "s8"
      ]
    },
    {
      "id": "h2",
      "title": "质量与监管",
      "text": "FDA记录Mohali工厂2017年恢复运营函及2023年不合规函。企业并购后的质量义务不能省略，也不能把工厂监管事项写成尚哈维个人定罪。",
      "sourceIds": [
        "s9"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-10-30",
      "title": "讨论研发与收购进展",
      "text": "业绩电话会中谈及研发投入；公司表示Organon仍是独立上市公司，交割尚有条件待满足。",
      "sourceIds": [
        "s8"
      ]
    },
    {
      "id": "t2",
      "date": "2026-04-26",
      "title": "公布Organon收购协议",
      "text": "美东时间4月26日公告对应印度4月27日；每股14美元现金，117.5亿美元为企业价值，不是个人购入金额。",
      "sourceIds": [
        "s7"
      ]
    },
    {
      "id": "t3",
      "date": "2025-09-01",
      "title": "交接董事总经理职务",
      "text": "Kirti Ganorkar接任，尚哈维继续任执行董事长；6月13日是此前公告日期。",
      "sourceIds": [
        "s1",
        "s3"
      ]
    },
    {
      "id": "t4",
      "date": "2023-03-06",
      "title": "完成Concert收购",
      "text": "太阳制药扩大研发组合；收购公告中的候选药当时仍处研发阶段，收购完成不等于药品获批。",
      "sourceIds": [
        "s6"
      ]
    },
    {
      "id": "t5",
      "date": "2016",
      "title": "获莲花士勋章",
      "text": "印度政府将其列入Padma Shri获奖名单，领域为贸易与工业。",
      "sourceIds": [
        "s12"
      ]
    },
    {
      "id": "t6",
      "date": "2015-03-25",
      "title": "宣布Ranbaxy合并完成",
      "text": "公告说明开始整合业务；公告日期与法律生效及会计追溯日期须分开。",
      "sourceIds": [
        "s5"
      ]
    },
    {
