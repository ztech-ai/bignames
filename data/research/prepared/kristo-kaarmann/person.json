  "role": "Wise联合创始人兼CEO",
  "summary": "克里斯托·卡尔曼是爱沙尼亚企业家，与Taavet Hinrikus共同创办TransferWise，后更名为Wise。他与团队发展跨境支付和多币种服务；其职业经历也包括咨询工作及监管披露处罚。",
  "coverageNote": "核对至2026年11月17日。区分服务上线与公司注册、品牌更名与上市，以及FCA披露处罚与HMRC税务处罚；公司经营陈述保留归属。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "共同创办Wise，推动在线跨境支付基础设施发展，改善个人及企业国际转账体验。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "塔尔图大学毕业记录载明其于2006年9月15日获信息学硕士；公司传记另列学士学位。"
    },
    {
      "id": "f2",
      "label": "早期工作",
      "value": "创办Wise前曾在Deloitte与PwC从事咨询，并参与生物信息学和数据挖掘研究。"
    }
  ],
  "highlights": [
