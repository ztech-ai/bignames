  "role": "UPS首席执行官、家得宝前首席财务官",
  "summary": "卡萝尔·托梅是美国企业管理者，长期负责家得宝财务，2020年出任UPS首席执行官。她的工作涉及包裹网络、客户组合及劳资谈判；UPS的经营调整也伴随人员缩减和转型费用，不能只用规模或利润描述其影响。",
  "coverageNote": "核对至2026年11月17日，近期依据为10月27日季报及其中对她发言的引述。区分董事与CEO、报告利润与调整后利润；捐赠承诺和未来业绩展望不记为已实现结果。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "领导UPS物流业务，参与全球包裹运输、电子商务配送与企业管理。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1979年毕业于怀俄明大学传播学专业，1981年获丹佛大学MBA，侧重金融。"
    },
    {
      "id": "f2",
      "label": "其他治理角色",
      "value": "Verizon现任独立董事及财务委员会成员；思科董事与亚特兰大联储董事均为前职，并非这些机构的CEO。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "网络调整与员工影响",
      "text": "2026年UPS表示完成亚马逊业务量缩减及网络重配；第二季度转型费用主要涉及人员缩减的离职成本，运营改善须与员工影响一并呈现。",
      "sourceIds": [
        "s10"
      ]
    },
    {
      "id": "h2",
      "title": "劳资共同谈判",
      "text": "2023年合同涉及薪资与安全保障，由公司、工会及会员投票共同形成；不能把全部谈判成果归于CEO个人。",
      "sourceIds": [
        "s7",
        "s8"
      ]
    }
  ],
  "timeline": [
