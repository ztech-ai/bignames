  "role": "NAVER创始人、董事长",
  "summary": "李海珍是韩国互联网企业家，早年任职三星SDS，参与创办NAVER，推动搜索及国际平台业务发展。他经历NHN时期、LINE业务扩展和全球投资工作，2025年重任NAVER董事长，参与AI基础设施合作。",
  "coverageNote": "核对至2026年11月17日。区分董事长与CEO、公司设立与早期项目，以及合作签约、投资交割和基础设施投运；团队产品不归为个人独创。",
  "influence": {
    "stars": 3,
    "scope": "regional",
    "rationale": "共同创办Naver，推动搜索、数字内容和通信平台发展，对韩国及国际互联网服务具有影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育背景",
      "value": "1990年获首尔大学计算机工程学士，1992年获KAIST计算机学硕士；KAIST实验室校友名单也列其为1992届硕士。"
    },
    {
      "id": "f2",
      "label": "董事长与经营层",
      "value": "2025年3月股东大会选其为内部董事，随后董事会选其为董事长；崔秀妍继续担任CEO。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "搜索与跨国通信平台",
      "text": "从韩国搜索业务拓展到LINE等海外服务，战略、工程和运营由多地团队及伙伴共同推进。",
      "sourceIds": [
        "s2",
        "s8",
        "s9"
      ]
    },
    {
      "id": "h2",
      "title": "AI算力基础设施合作",
      "text": "参与NAVER与NVIDIA、Brookfield的合作。2026年10月已签基础设施协议，后续股权交易及分期建设不等于当时已全部完成。",
      "sourceIds": [
        "s4",
        "s10",
        "s12"
      ]
    }
  ],
  "timeline": [
    {
      "id": "t1",
      "date": "2026-10-27",
      "title": "公司签署Brookfield基础设施协议",
      "text": "公告称满足NVIDIA战略股权投资的前提条件，增资手续尚待完成；2027至2028年分阶段投运目标仍是计划。",
      "sourceIds": [
