  "role": "ASML总裁兼首席执行官",
  "summary": "克里斯托夫·富凯是法国半导体设备业管理者，先后负责ASML应用业务、EUV业务及整体业务，2024年出任总裁兼首席执行官。他的工作连接技术产业化、客户需求与企业经营，光刻技术成果来自团队和合作伙伴。",
  "coverageNote": "核对至2026年11月17日。区分管理委员会与监事会、任命与履新，以及业务预测与已实现业绩；出生仅保留年份。",
  "influence": {
    "stars": 3,
    "scope": "field",
    "rationale": "参与ASML极紫外光刻技术与企业经营，对先进半导体制造设备的发展具有影响。",
    "assessedAt": "2026-11-13",
    "methodVersion": "1.0",
    "reviewStatus": "provisional"
  },
  "facts": [
    {
      "id": "f1",
      "label": "教育",
      "value": "获Institut Polytechnique de Grenoble物理学硕士学位。"
    },
    {
      "id": "f2",
      "label": "早期经历",
      "value": "加入ASML前，曾在Applied Materials和KLA Tencor任职。"
    }
  ],
  "highlights": [
    {
      "id": "h1",
      "title": "EUV业务管理",
      "text": "2018至2022年领导EUV业务，参与极紫外光刻产业化；不将团队成果归为个人独创。",
      "sourceIds": [
        "s1",
        "s3"
      ]
    },
    {
      "id": "h2",
      "title": "企业治理",
      "text": "担任ASML总裁兼CEO，并于2026年加入Airbus董事会任非执行董事；两个职务分属不同公司。",
      "sourceIds": [
        "s1",
        "s5"
      ]
    }
  ],
