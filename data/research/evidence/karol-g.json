    "thumbnailUrl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/2023-11-16_Gala_de_los_Latin_Grammy%2C_15_%28cropped_2%29.jpg/960px-2023-11-16_Gala_de_los_Latin_Grammy%2C_15_%28cropped_2%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
    "width": 2838,
    "height": 3965,
    "mediaTimestamp": "2025-07-11T22:46:15Z",
    "license": "CC BY-SA 2.0",
