  "intro": {
    "language": "en",
    "text": "Daniela Amodei (born 1987) is an American entrepreneur and the president of Anthropic, an artificial intelligence (AI) company known for its Claude series of large language models. She co-founded Anthropic in 2021 with her brother Dario Amodei. Prior to her work at Anthropic, she was the vice president of safety and policy at OpenAI.",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
