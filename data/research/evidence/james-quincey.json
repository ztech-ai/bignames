  "intro": {
    "language": "en",
    "text": "James Robert B. Quincey (born 8 January 1965) is a British businessman based in the United States. After starting his career at Bain & Co, he joined The Coca-Cola Company in 1996 and was later named chief operating officer (COO). He became the chief executive officer (CEO) in 2017 and the chairman of the board in 2019.",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
