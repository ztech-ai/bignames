  "intro": {
    "language": "en",
    "text": "Hindou Oumarou Ibrahim is a Chadian environmental activist and geographer. She is the Coordinator of the Association of Peul Women and Autochthonous Peoples of Chad (AFPAT) and served as the co-director of the pavilion of the World Indigenous Peoples’ Initiative and Pavilion at COP21, COP22 and COP23.",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
