  "intro": {
    "language": "en",
    "text": "Kate Raworth (born 13 December 1970) is an English economist known for \"doughnut economics\", an economic model that balances between essential human needs and planetary boundaries. Raworth is senior associate at the University of Oxford's Environmental Change Institute and a Professor of Practice at Amsterdam University of Applied Sciences.",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
