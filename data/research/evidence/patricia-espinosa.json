  "intro": {
    "language": "en",
    "text": "Patricia Espinosa Cantellano (born October 21, 1958) is a Mexican diplomat who served as the executive secretary of the United Nations Framework Convention on Climate Change from 2016 to 2022. She was Secretary of Foreign Affairs in the cabinet of President Felipe Calderón; and served as Mexican Ambassador to Austria, Germany, Slovenia and Slovakia. Because of her diplomatic career, she was appointed Ambassador Emeritus of Mexico in 2012.",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
