  "intro": {
    "language": "en",
    "text": "Joy Adowaa Buolamwini is a Canadian-American computer scientist and digital activist formerly based at the MIT Media Lab. She founded the Algorithmic Justice League (AJL), an organization that works to challenge bias in decision-making software, using art, advocacy, and research to highlight the social implications and harms of artificial intelligence (AI).\n\n",
    "sourceId": "wikipedia-en",
    "usage": "Research excerpt; paraphrase and cross-check before publication."
  },
